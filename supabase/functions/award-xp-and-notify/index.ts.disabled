// DISABLED 2026-09-09. Kept here because this was the ONLY copy — the edge
// functions had no source control at all, they existed only in production.
//
// Why it was disabled: `amount` and `milestone_slug` come straight from the
// request body, and the function then calls award_xp() and
// check_and_award_milestone() with the SERVICE ROLE key. verify_jwt is on, so
// the target is always the caller's own id — but any signed-in member could
// POST { amount: 999999 } and jump to Level 10, or POST a milestone_slug and
// clear any rung gate on the ladder.
//
// Revoking EXECUTE on those two functions (2026-09-09_close_the_anon_rpc_holes)
// did NOT close this: service_role is not subject to grants. Nothing in the app
// calls this function — XP runs through src/xp.js and milestones through
// src/milestones_engine.js — so it is replaced in production by a 410 stub.
//
// To restore: redeploy this file with verify_jwt true, having first made
// `amount` server-derived rather than caller-supplied.

import 'jsr:@supabase/functions-js/edge-runtime.d.ts';
import { createClient } from 'jsr:@supabase/supabase-js@2';

const EMAIL_MILESTONES = new Set([
  'first_dollar', 'hundred_dollars', 'thousand_dollars', 'one_k_mrr', 'ten_k_mrr',
  'first_beta_tester', 'twenty_beta_testers', 'seven_day_streak', 'thirty_day_streak',
  'first_sprint_done', 'blueprint_created'
]);

Deno.serve(async (req: Request) => {
  if (req.method === 'OPTIONS') return new Response(null, { headers: { 'Access-Control-Allow-Origin': '*', 'Access-Control-Allow-Headers': 'authorization, x-client-info, apikey, content-type' } });

  try {
    const authHeader = req.headers.get('Authorization');
    if (!authHeader) return new Response(JSON.stringify({ error: 'Missing authorization' }), { status: 401 });

    const supabase = createClient(Deno.env.get('SUPABASE_URL')!, Deno.env.get('SUPABASE_SERVICE_ROLE_KEY')!);
    const { data: { user } } = await supabase.auth.getUser(authHeader.replace('Bearer ', ''));
    if (!user) return new Response(JSON.stringify({ error: 'Unauthorized' }), { status: 401 });

    const { amount, reason, entity_type, entity_id, milestone_slug, notification_message } = await req.json();
    const results: Record<string, unknown> = {};

    // THE HOLE: `amount` is caller-supplied.
    if (amount && amount > 0) {
      await supabase.rpc('award_xp', { p_user_id: user.id, p_amount: amount, p_reason: reason || 'Activity', p_entity_type: entity_type || null, p_entity_id: entity_id || null });
      results.xp_awarded = amount;
    }

    // THE OTHER HOLE: any milestone slug clears the rung gate that reads it.
    if (milestone_slug) {
      const { data: milestoneAwarded } = await supabase.rpc('check_and_award_milestone', { p_user_id: user.id, p_slug: milestone_slug });
      results.milestone_awarded = milestoneAwarded;

      if (milestoneAwarded && EMAIL_MILESTONES.has(milestone_slug)) {
        const { data: milestone } = await supabase
          .from('predefined_milestones').select('title, emoji, xp_reward').eq('slug', milestone_slug).single();
        if (milestone) {
          const { data: profile } = await supabase.from('profiles').select('display_name, milestone_emails_enabled').eq('id', user.id).single();
          if (profile?.milestone_emails_enabled !== false) {
            const emailRes = await fetch(`${Deno.env.get('SUPABASE_URL')}/functions/v1/send-email`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${Deno.env.get('SUPABASE_SERVICE_ROLE_KEY')}` },
              body: JSON.stringify({
                type: 'milestone_achieved', user_id: user.id, to_email: user.email,
                to_name: profile?.display_name || 'Founder',
                data: { title: milestone.title, emoji: milestone.emoji, xp_reward: milestone.xp_reward }
              })
            });
            results.milestone_email = await emailRes.json();
          }
        }
      }
    }

    // Badge sweep — the one genuinely useful part, and it is duplicated by
    // src/milestones_engine.js, which the app actually runs.
    const { data: profile } = await supabase.from('profiles').select('xp_total, tasks_completed, streak_days').eq('id', user.id).single();
    const { data: existingBadges } = await supabase.from('user_badges').select('badge_id').eq('user_id', user.id);
    const ownedIds = new Set((existingBadges || []).map((b: {badge_id:string}) => b.badge_id));
    const { data: allBadges } = await supabase.from('badges').select('*').eq('is_active', true);
    const newBadges: string[] = [];

    for (const badge of (allBadges || [])) {
      if (ownedIds.has(badge.id)) continue;
      let earned = false;
      if (badge.slug === 'idea_starter') {
        const { count } = await supabase.from('generated_ideas').select('id', { count: 'exact', head: true }).eq('user_id', user.id);
        earned = (count || 0) >= 1;
      } else if (badge.slug === 'blueprint_maker') {
        const { count } = await supabase.from('blueprints').select('id', { count: 'exact', head: true }).eq('user_id', user.id);
        earned = (count || 0) >= 1;
      } else if (badge.slug === 'sprint_starter') {
        const { count } = await supabase.from('sprints').select('id', { count: 'exact', head: true }).eq('user_id', user.id);
        earned = (count || 0) >= 1;
      } else if (badge.slug === 'task_crusher') {
        earned = (profile?.tasks_completed || 0) >= 25;
      } else if (badge.slug === 'streak_seeker') {
        earned = (profile?.streak_days || 0) >= 7;
      } else if (badge.slug === 'community_builder') {
        const { count } = await supabase.from('posts').select('id', { count: 'exact', head: true }).eq('user_id', user.id);
        earned = (count || 0) >= 10;
      } else if (badge.slug === 'revenue_earner') {
        const { data: totalRevenue } = await supabase.from('revenue_entries').select('amount').eq('user_id', user.id).eq('entry_type', 'revenue');
        const total = (totalRevenue || []).reduce((s: number, r: {amount: number}) => s + Number(r.amount), 0);
        earned = total >= 1;
      }
      if (earned) {
        await supabase.from('user_badges').insert({ user_id: user.id, badge_id: badge.id });
        await supabase.rpc('award_xp', { p_user_id: user.id, p_amount: badge.xp_reward, p_reason: `Badge: ${badge.name}` });
        await supabase.from('notifications').insert({
          user_id: user.id, type: 'badge', entity_type: 'badge', entity_id: badge.id,
          message: `🏅 You earned the "${badge.name}" badge! +${badge.xp_reward} XP`
        });
        newBadges.push(badge.name);
      }
    }
    results.new_badges = newBadges;

    if (notification_message) {
      await supabase.from('notifications').insert({ user_id: user.id, type: 'system', message: notification_message });
    }

    return new Response(JSON.stringify({ success: true, ...results }), { headers: { 'Content-Type': 'application/json', 'Access-Control-Allow-Origin': '*' } });
  } catch (err) {
    const message = err instanceof Error ? err.message : 'Unknown error';
    return new Response(JSON.stringify({ error: message }), { status: 500 });
  }
});
