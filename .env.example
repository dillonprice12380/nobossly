PORT=3000
SUPABASE_URL=https://wzuptydjilpqafhwtbwq.supabase.co
SUPABASE_ANON_KEY=sb_publishable_fM96ZtMEAzuTRIYqRzLauw_JM0oYNZ1
# Service role key — get from Supabase Dashboard > Settings > API > service_role
# Required for the admin backfill-profiles tool and the re-engagement email
# sweep (both read auth.users). Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SITE_URL=https://nobossly.com

# Premium checkout (Stripe). SUB_SYNC_SECRET must equal app_secrets.sub_sync in
# the database, or payments will not unlock Premium.
STRIPE_SECRET_KEY=sk_live_or_test_key
SUB_SYNC_SECRET=shared-secret-matching-app_secrets
# Signing secret of the /billing/webhook endpoint in Stripe (whsec_...).
STRIPE_WEBHOOK_SECRET=whsec_your_endpoint_secret

# Premium checkout (PayPal). Optional; without these no PayPal buttons show.
# PAYPAL_WEBHOOK_ID is the id of the webhook pointing at /billing/paypal/webhook.
# PAYPAL_ENV=sandbox switches to PayPal's sandbox (anything else is live).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=
# Sandbox test copies only: the sandbox plan ids (the live ids in pricing_tiers are ignored there).
PAYPAL_SANDBOX_PLAN_MONTH=
PAYPAL_SANDBOX_PLAN_YEAR=

# Outbound email (Resend). Without RESEND_API_KEY no mail is sent and the app
# behaves exactly as before. SUPABASE_SERVICE_ROLE_KEY is also required for the
# re-engagement sweep, which reads across users.
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=NoBossly <hello@nobossly.com>
