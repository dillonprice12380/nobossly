<%- include('partials/head') %>
<%
  // One renderer over src/paths.js. Every question on every path comes through
  // here, so a new path is a data change rather than another form to maintain.
  var pa = pathAnswers || {};
  function current(qq) {
    var v = qq.col ? q[qq.col] : pa[qq.name];
    return (v === null || v === undefined) ? '' : v;
  }
  function esc(v) {
    return String(v == null ? '' : v)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }
  function asText(v) { return Array.isArray(v) ? v.join(', ') : String(v == null ? '' : v); }
%>
<style>
  .path-grid { display: grid; gap: .8rem; margin: 1.1rem 0 .6rem; }
  @media (min-width: 44rem) { .path-grid { grid-template-columns: 1fr 1fr; } }
  /* Two-column grid so the radio sits in its own track and can never ride over
     the text. The global "input { width:100% }" rule applies to radios too,
     which is what used to push the control into the middle of the title. */
  .path-card {
    display: grid; grid-template-columns: auto 1fr; column-gap: .75rem; row-gap: .2rem;
    align-items: start; margin: 0; padding: 1rem 1.1rem; cursor: pointer; font-weight: 400;
    background: var(--panel-2); border: 1px solid var(--border); border-radius: 12px;
    transition: border-color .15s ease, background .15s ease;
  }
  .path-card:hover { border-color: var(--accent); }
  .path-card input[type="radio"] {
    grid-row: 1 / span 2; align-self: start;
    width: auto; min-width: 0; margin: .3rem 0 0; padding: 0;
    accent-color: var(--accent);
  }
  .path-card:has(input:checked) { border-color: var(--accent); background: rgba(16,185,129,.1); }
  .path-title { grid-column: 2; display: block; font-weight: 700; }
  .path-desc { grid-column: 2; display: block; font-size: .9rem; font-weight: 400; color: var(--muted); line-height: 1.45; }
  .field-hint { display: block; margin-top: .3rem; font-weight: 400; line-height: 1.4; }
  .check-grid { display: flex; flex-wrap: wrap; gap: .4rem .8rem; margin-top: .35rem; }
  .check-grid .check { display: inline-flex; align-items: center; gap: .35rem; font-weight: 400; margin: 0; }
  .check-grid .check input { width: auto; min-width: 0; margin: 0; accent-color: var(--accent); }
  .step-line { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
</style>

<div class="page-head">
  <div>
    <% if (step === 1) { %>
      <h1>What is your way out?</h1>
      <p class="muted">Pick the closest one — you can change it later by answering again. The questions after this are written for that path, so the more honest the pick, the more useful everything downstream.</p>
    <% } else { %>
      <h1><%= pathDef ? pathDef.emoji + ' ' + pathDef.label : 'Your questions' %></h1>
      <p class="muted step-line">
        <% if (!deepening) { %>
          Step 2 of 2 — this is everything your Compass needs, including the hours and runway you actually have. About two minutes.
        <% } else { %>
          Sharpening — step <%= step - requiredSteps %> of <%= totalSteps - requiredSteps %>. Stop whenever you like; you keep what you have.
        <% } %>
        <% if (run > 1) { %><span class="chip">Run #<%= run %></span><% } %>
      </p>
    <% } %>
  </div>
  <% if (canCancel) { %><a class="btn btn-ghost" href="/compass">Back to my Compass</a><% } %>
</div>

<% if (msg) { %><p class="notice"><%= msg %></p><% } %>

<div class="card">
  <form method="post" action="/questionnaire">
    <input type="hidden" name="step" value="<%= step %>">

    <% if (step === 1) { %>
      <div class="path-grid">
        <% paths.forEach(function (p) { %>
          <label class="path-card">
            <input type="radio" name="founder_path" value="<%= p.slug %>" <%= path === p.slug ? 'checked' : '' %> required>
            <span class="path-title"><%= p.emoji %> <%= p.label %></span>
            <span class="path-desc"><%= p.blurb %></span>
          </label>
        <% }) %>
      </div>
      <button class="btn btn-primary btn-lg">Continue →</button>

    <% } else { %>
      <% questions.forEach(function (qq) { %>
        <% var val = current(qq); %>
        <label class="small">
          <%= qq.label %><%= qq.required ? ' *' : '' %>

          <% if (qq.type === 'textarea') { %>
            <textarea name="<%= qq.name %>" rows="3" maxlength="2000" <%= qq.required ? 'required' : '' %>
              <%= qq.placeholder ? 'placeholder="' + esc(qq.placeholder) + '"' : '' %>><%= asText(val) %></textarea>

          <% } else if (qq.type === 'select') { %>
            <select name="<%= qq.name %>" <%= qq.required ? 'required' : '' %>>
              <option value="">—</option>
              <% qq.options.forEach(function (o) { %>
                <option value="<%= esc(o) %>" <%= String(val) === String(o) ? 'selected' : '' %>><%= o %></option>
              <% }) %>
            </select>

          <% } else if (qq.type === 'checks') { %>
            <span class="check-grid">
              <% qq.options.forEach(function (o) { %>
                <label class="check">
                  <input type="checkbox" name="<%= qq.name %>" value="<%= esc(o) %>"
                    <%= (Array.isArray(val) && val.indexOf(o) >= 0) ? 'checked' : '' %>> <%= o %>
                </label>
              <% }) %>
            </span>

          <% } else { %>
            <%# text, csv and url all render as one line; csv joins the array back
                for editing and is split again on save. %>
            <input type="<%= qq.type === 'url' ? 'url' : 'text' %>" name="<%= qq.name %>"
              maxlength="500" value="<%= esc(asText(val)) %>" <%= qq.required ? 'required' : '' %>
              <%= qq.placeholder ? 'placeholder="' + esc(qq.placeholder) + '"' : '' %>>
          <% } %>

          <% if (qq.hint) { %><span class="muted small field-hint"><%= qq.hint %></span><% } %>
        </label>
      <% }) %>

      <div class="cta-row">
        <button class="btn btn-primary btn-lg">
          <%= step < requiredSteps ? 'Continue →' : (deepening ? (step < totalSteps ? 'Save & continue →' : 'Save & redraw my Compass →') : 'Draw my Compass →') %>
        </button>
        <% if (step > 1) { %><a class="btn btn-ghost" href="/questionnaire?step=<%= step - 1 %>">Back</a><% } %>
        <% if (deepening) { %><a class="btn btn-ghost" href="/compass">Stop here</a><% } %>
      </div>
    <% } %>
  </form>
</div>

<% if (step === requiredSteps) { %>
  <p class="muted small" style="margin-top:.8rem">Nothing here is permanent. Answering again — from your Compass — starts a fresh run, and you can pick a different path then.</p>
<% } %>
<%- include('partials/foot') %>
