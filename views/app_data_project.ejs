<%- include('partials/head') %>
<%# After a "Connect with …" sign-in: pick the project (src/app_data/index.js chooseProject). %>
<div class="page-head">
  <div><h1>Choose a project</h1><p class="muted"><%= conn.kind === 'planetscale' ? 'Pick the database your app uses. NoBossly makes its own read-only login on its main branch.' : 'Pick the project your app uses.' %></p></div>
  <a class="btn btn-ghost btn-sm" href="/app-data">← Your app's users</a>
</div>
<% if (msg) { %><p class="notice"><%= msg %></p><% } %>
<% if (error) { %><div class="card"><p style="margin:0;color:var(--danger)"><%= error %></p></div><% } %>
<% if (!error && !projects.length) { %><div class="card"><p class="muted" style="margin:0">That account has no projects NoBossly can see. Sign in with the account that owns your app's project.</p></div><% } %>
<% if (projects.length) { %>
  <form class="card form-card" method="post" action="/app-data/<%= conn.id %>/project" style="max-width:640px">
    <% projects.forEach(function (p, i) { %>
      <label class="check ad-proj"><input type="radio" name="project" value="<%= p.id %>" <%= i === 0 ? 'checked' : '' %> required> <span><strong><%= p.name %></strong> <span class="muted small"><%= p.note %></span></span></label>
    <% }) %>
    <button class="btn btn-primary" style="margin-top:.6rem">Use this one</button>
  </form>
<% } %>
<form method="post" action="/app-data/<%= conn.id %>/disconnect" class="inline" style="margin-top:.8rem"><button class="btn btn-ghost btn-sm">Cancel and disconnect</button></form>
<style>
  .ad-proj { display: flex; gap: .55rem; align-items: center; padding: .5rem 0; border-top: 1px solid var(--border); }
  .ad-proj:first-of-type { border-top: 0; }
  .ad-proj input { width: auto; margin: 0; }
</style>
<%- include('partials/foot') %>
