<%- include('../partials/head') %>
<% var who = pmap[s.user_id] || {}, snap = s.snapshot || null, data = snap && snap.data || {};
   var STATUS = { submitted: 'Waiting for review', returned: 'Sent back', approved: 'Approved ✓' }; %>
<a class="muted small" href="/groups/<%= group.slug %>/assignments/<%= a.id %>">← <%= a.title %></a>
<div class="page-head"><div>
  <h1 style="margin:.2rem 0 0"><%= who.display_name || who.username || 'A member' %> — <%= a.title %></h1>
  <p class="muted small" style="margin:.2rem 0 0"><%= STATUS[s.status] %> · handed in <%= new Date(s.submitted_at).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) %></p>
</div></div>
<% if (msg) { %><p class="notice"><%= msg %></p><% } %>

<% if (snap && snap.kind === 'worksheet') { %>
  <div class="card">
    <h3 style="margin-top:0"><%= (sheet && sheet.emoji) || '' %> <%= snap.title || (sheet && sheet.label) || 'Worksheet' %></h3>
    <% if (!sheet) { %>
      <pre class="small"><%= JSON.stringify(data, null, 2) %></pre>
    <% } else if (sheet.layout === 'matrix') { %>
      <% var opts = data.options || [], crits = data.criteria || [], sc = data.scores || {}; %>
      <div style="overflow-x:auto"><table class="sb-table"><thead><tr><th></th><% crits.forEach(function (c) { %><th><%= c.label %> <span class="muted small">×<%= c.weight %></span></th><% }) %></tr></thead>
        <tbody><% opts.forEach(function (o, i) { %><tr><th><%= o %></th><% crits.forEach(function (c, j) { %><td><%= sc[i + ':' + j] || '–' %></td><% }) %></tr><% }) %></tbody></table></div>
      <% if (data.decision) { %><p><strong>Decision:</strong> <%= data.decision %></p><% } %>
    <% } else { %>
      <% sheet.sections.forEach(function (sec) { var v = data[sec.key]; if (v === undefined || v === '' || (Array.isArray(v) && !v.length)) return; %>
        <div class="sb-field">
          <p class="muted small" style="margin:0"><%= sec.label %></p>
          <% if (Array.isArray(v)) { %><ul style="margin:.2rem 0"><% v.forEach(function (x) { %><li><%= x %></li><% }) %></ul>
          <% } else if (sec.type === 'money') { %><p style="margin:.2rem 0">$<%= Number(v).toLocaleString('en-US') %></p>
          <% } else { %><p class="pre" style="margin:.2rem 0"><%= v %></p><% } %>
        </div>
      <% }) %>
    <% } %>
  </div>
<% } else if (snap && snap.kind === 'board') { %>
  <div class="card">
    <h3 style="margin-top:0"><%= (board && board.emoji) || '🗂️' %> <%= (board && board.label) || 'Board' %></h3>
    <% var stages = board ? board.stages : []; var byStage = {}; (snap.items || []).forEach(function (it) { (byStage[it.stage] = byStage[it.stage] || []).push(it); });
       var keys = stages.map(function (x) { return x.key; }).concat(Object.keys(byStage).filter(function (k) { return !stages.some(function (x) { return x.key === k; }); })); %>
    <% keys.forEach(function (k) { var items = byStage[k] || []; if (!items.length) return; var st = stages.find(function (x) { return x.key === k; }); %>
      <p class="small" style="margin:.8rem 0 .2rem"><strong><%= st ? st.label : k %></strong> <span class="muted">(<%= items.length %>)</span></p>
      <ul style="margin:0"><% items.forEach(function (it) { %><li><%= it.title %><% if (it.value !== null && it.value !== undefined) { %> <span class="muted small">· $<%= Number(it.value).toLocaleString('en-US') %></span><% } %><% if (it.due_on) { %> <span class="muted small">· <%= it.due_on %></span><% } %></li><% }) %></ul>
    <% }) %>
  </div>
<% } %>
<% if (s.link_url) { %><div class="card"><p style="margin:0"><strong>Link:</strong> <a href="<%= s.link_url %>" rel="noopener noreferrer nofollow" target="_blank"><%= s.link_url %></a></p></div><% } %>
<% if (s.body) { %><div class="card"><p class="muted small" style="margin:0"><%= a.kind === 'text' ? 'Answer' : 'Note' %></p><p class="pre" style="margin:.3rem 0 0"><%= s.body %></p></div><% } %>

<% if (s.feedback) { %>
  <div class="card" style="border-left:3px solid var(--accent-2)">
    <p class="muted small" style="margin:0">Feedback from <%= (pmap[s.reviewed_by] || {}).display_name || 'the program team' %><%= s.reviewed_at ? ' · ' + new Date(s.reviewed_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '' %></p>
    <p class="pre" style="margin:.3rem 0 0"><%= s.feedback %></p>
  </div>
<% } %>

<% if (ctx.isLeader && s.user_id !== user.id) { %>
  <form method="post" action="/groups/<%= group.slug %>/assignments/<%= a.id %>/s/<%= s.id %>/review" class="card form-card" style="max-width:760px">
    <h3 style="margin-top:0">Review</h3>
    <label>Feedback<textarea name="feedback" rows="4" maxlength="3000" placeholder="What is working, and what to change"><%= s.feedback || '' %></textarea></label>
    <div class="cta-row" style="justify-content:flex-start;gap:.5rem">
      <button class="btn btn-primary" name="status" value="approved">Approve</button>
      <button class="btn btn-ghost" name="status" value="returned">Send back with feedback</button>
    </div>
  </form>
<% } %>
<style>
  .sb-field { padding: .5rem 0; border-top: 1px solid var(--border); }
  .sb-field:first-of-type { border-top: 0; }
  .sb-table { border-collapse: collapse; min-width: 100%; }
  .sb-table th, .sb-table td { padding: .35rem .5rem; border-bottom: 1px solid var(--border); text-align: left; }
</style>
<%- include('../partials/foot') %>
