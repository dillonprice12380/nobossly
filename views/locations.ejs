<%- include('partials/head') %>
<div class="page-head"><div><h1><svg class="icon icon-lg"><use href="#i-milestone"/></svg> Start a Business by State</h1><p class="muted">State-by-state guides to registering, licensing, and launching your business &mdash; costs, forms, and deadlines specific to where you're filing.</p></div></div>

<div class="grid-3">
  <% locations.forEach(l => { %>
    <% if (l.guide) { %>
      <a class="card post-card" href="/guides/<%= l.guide.slug %>" style="margin-bottom:0">
        <h3 class="post-card-title"><%= l.name %></h3>
        <p class="muted small" style="margin:.4rem 0 0">Start a business guide →</p>
      </a>
    <% } else { %>
      <div class="card post-card" style="margin-bottom:0;opacity:.55;cursor:default">
        <h3 class="post-card-title"><%= l.name %></h3>
        <p class="muted small" style="margin:.4rem 0 0">Coming soon</p>
      </div>
    <% } %>
  <% }) %>
</div>

<%- include('partials/foot') %>
