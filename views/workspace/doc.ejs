<%- include('../partials/head') %>
<div class="page-head"><div>
  <a class="muted small" href="/workspace/docs/<%= kind %>">← <%= def.label %></a>
  <h1 style="margin:.2rem 0 0"><%= def.emoji %> <%= doc.title || def.label %></h1>
  <p class="muted small" style="margin:.2rem 0 0"><%= progress.done %> of <%= progress.total %> filled in · last saved <%= new Date(doc.updated_at).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) %></p>
</div>
<div class="ws-actions">
  <a class="btn btn-ghost btn-sm" href="/workspace/docs/<%= kind %>/<%= doc.id %>/view">View<%= def.layout === 'canvas' ? ' canvas' : '' %></a>
  <a class="btn btn-ghost btn-sm" href="/workspace/docs/<%= kind %>/<%= doc.id %>/view?pdf=1">Download PDF</a>
  <% if (typeof canShare !== 'undefined' && canShare) { %><a class="btn btn-ghost btn-sm" href="/workspace/docs/<%= kind %>/<%= doc.id %>/share">Share</a><% } %>
  <a class="btn btn-ghost btn-sm" href="/workspace">Workspace</a>
</div></div>
<% if (saved) { %><p class="notice">Saved.</p><% } %>

<% if (score) { %>
  <div class="card" style="border-left:3px solid var(--accent-2)">
    <p style="margin:0"><strong>Score: <%= score.total %> / <%= score.of %></strong><% if (!score.complete) { %> <span class="muted small">(score all five for the full picture)</span><% } %> · Weakest: <strong><%= score.weakest %></strong> — that is what your smallest test should check.</p>
  </div>
<% } %>

<% if (typeof summary !== 'undefined' && summary && summary.length) { %>
  <div class="card ws-summary" style="border-left:3px solid var(--accent-2);max-width:820px">
    <% summary.forEach(function (x) { %>
      <div class="ws-sum-row"><span class="muted small"><%= x.label %></span><strong style="<%= x.tone === 'bad' ? 'color:var(--danger)' : x.tone === 'good' ? 'color:var(--accent-2)' : '' %>"><%= x.value %></strong></div>
    <% }) %>
    <p class="muted small" style="margin:.4rem 0 0">Worked out from what you have filled in. Save to update.</p>
  </div>
  <style>.ws-sum-row { display: flex; justify-content: space-between; gap: 1rem; padding: .15rem 0; }</style>
<% } %>
<% if (def.layout === 'matrix') { %>
<%- include('matrix_form', { def: def, kind: kind, doc: doc, data: data, matrix: matrix }) %>
<% } else { %>
<% var val = function (s) { var v = data[s.key]; return Array.isArray(v) ? v.join('\n') : (v == null ? '' : v); }; %>
<form method="post" action="/workspace/docs/<%= kind %>/<%= doc.id %>" class="<%= def.layout === 'canvas' ? 'ws-canvas' : 'card form-card' %>" style="<%= def.layout === 'canvas' ? '' : 'max-width:820px' %>" <%= def.layout === 'canvas' ? 'data-autosave' : '' %>>
  <div class="<%= def.layout === 'canvas' ? 'card' : '' %>" style="<%= def.layout === 'canvas' ? 'grid-column:1/-1' : '' %>">
    <label><%= def.titleLabel || 'Name' %><input name="title" maxlength="120" value="<%= doc.title || '' %>"></label>
  </div>
  <% def.sections.forEach(function (s) { %>
    <div class="<%= def.layout === 'canvas' ? 'card ws-box ws-' + s.key : 'ws-field' %>">
      <% if (s.type === 'rich') { %>
        <div class="ws-rich-head"><strong><%= s.label %></strong>
          <% if (s.help) { %><span class="muted small" style="display:block"><%= s.help %></span><% } %></div>
        <div class="rt" data-rt>
          <textarea name="<%= s.key %>" rows="6" aria-label="<%= s.label %>"><%= typeof richHtml === 'function' ? richHtml(data[s.key]) : val(s) %></textarea>
        </div>
      <% } else if (s.type === 'score') { %>
        <fieldset class="ws-score"><legend><strong><%= s.label %></strong></legend>
          <% if (s.help) { %><p class="muted small" style="margin:0 0 .3rem"><%= s.help %></p><% } %>
          <% [1,2,3,4,5].forEach(function (n) { %><label class="chip"><input type="radio" name="<%= s.key %>" value="<%= n %>" <%= data[s.key] === n ? 'checked' : '' %>> <%= n %></label><% }) %>
        </fieldset>
      <% } else { %>
        <label><strong><%= s.label %></strong><% if (s.type === 'list') { %> <span class="muted small">(one per line)</span><% } %>
          <% if (s.help) { %><span class="muted small" style="display:block;font-weight:normal"><%= s.help %></span><% } %>
          <% if (s.type === 'longtext' || s.type === 'list') { %>
            <textarea name="<%= s.key %>" rows="<%= def.layout === 'canvas' ? 5 : (s.key === 'pitch' ? 6 : 3) %>" maxlength="<%= s.type === 'list' ? 6000 : 3000 %>"><%= val(s) %></textarea>
          <% } else if (s.type === 'select') { %>
            <select name="<%= s.key %>"><option value="">—</option><% (s.options || []).forEach(function (o) { %><option <%= data[s.key] === o ? 'selected' : '' %>><%= o %></option><% }) %></select>
          <% } else if (s.type === 'money' || s.type === 'number') { %>
            <input name="<%= s.key %>" inputmode="decimal" value="<%= val(s) %>" placeholder="<%= s.type === 'money' ? '$' : '' %>">
          <% } else if (s.type === 'date') { %>
            <input type="date" name="<%= s.key %>" value="<%= val(s) %>">
          <% } else { %>
            <input name="<%= s.key %>" maxlength="200" value="<%= val(s) %>">
          <% } %>
        </label>
        <% if (s.key === 'pitch' && pitch) { %><p class="muted small" style="margin:-.2rem 0 0"><%= pitch.words %> words · about <%= pitch.seconds %> seconds out loud</p><% } %>
      <% } %>
    </div>
  <% }) %>
  <div class="<%= def.layout === 'canvas' ? 'card' : '' %> cta-row" style="justify-content:flex-start;gap:.5rem;<%= def.layout === 'canvas' ? 'grid-column:1/-1' : '' %>">
    <button class="btn btn-primary">Save</button>
    <% if (def.layout === 'canvas') { %><span class="muted small" data-save-status aria-live="polite">Saves automatically as you type.</span><% } %>
  </div>
</form>
<script src="/js/richtext.js?v=1"></script>
<% } %>

<% if (kind === 'elevator_pitch' && (data.versions || []).length) { %>
  <div class="card" style="max-width:820px">
    <h3 style="margin-top:0">Earlier versions</h3>
    <% data.versions.forEach(function (v) { %>
      <div class="milestone-row"><div><p style="margin:.2rem 0;white-space:pre-wrap"><%= v.text %></p><p class="muted small" style="margin:0"><%= new Date(v.saved_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></p></div></div>
    <% }) %>
  </div>
<% } %>

<div class="cta-row" style="justify-content:flex-start;gap:.5rem;margin-top:.8rem">
  <form method="post" action="/workspace/docs/<%= kind %>/<%= doc.id %>/duplicate"><button class="btn btn-ghost btn-sm">Make a copy</button></form>
  <form method="post" action="/workspace/docs/<%= kind %>/<%= doc.id %>/delete" onsubmit="return confirm('Delete this for good?')"><button class="btn btn-ghost btn-sm">Delete</button></form>
</div>
<style>
  .ws-actions { display: flex; gap: .4rem; flex-wrap: wrap; justify-content: flex-end; }
  /* Canvases: two columns, stacked on phones. */
  .ws-canvas { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8rem; }
  @media (max-width: 760px) { .ws-canvas { grid-template-columns: 1fr; } }
  .ws-canvas .ws-box { margin: 0; display: flex; flex-direction: column; }
  .ws-canvas .ws-box textarea { width: 100%; }
  .ws-rich-head { margin-bottom: .45rem; }
  /* The formatted-text editor (public/js/richtext.js). */
  .rt { border: 1px solid var(--border); border-radius: 10px; background: var(--panel-2, transparent); flex: 1; display: flex; flex-direction: column; }
  .rt.focus { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 20%, transparent); }
  .rt textarea { border: 0; background: transparent; min-height: 9rem; }
  .rt-bar { display: flex; flex-wrap: wrap; gap: .1rem; padding: .25rem; border-bottom: 1px solid var(--border); position: sticky; top: 0; }
  .rt-btn { background: transparent; border: 1px solid transparent; color: inherit; border-radius: 6px; min-width: 1.75rem; height: 1.85rem; padding: 0 .25rem; cursor: pointer; font-size: .85rem; line-height: 1; }
  .rt-btn:hover { border-color: var(--border); }
  .rt-btn.on { background: color-mix(in srgb, var(--accent) 22%, transparent); border-color: var(--accent); }
  .rt-btn small { font-size: .6rem; margin-left: .1rem; }
  .rt-sep { width: 1px; background: var(--border); margin: .3rem .1rem; }
  .rt-a { border-bottom: 3px solid #dc2626; padding: 0 .1rem; }
  .rt-hl { background: #fef08a; color: #14201c; padding: 0 .2rem; border-radius: 2px; }
  .rt-holder { position: relative; display: inline-flex; }
  .rt-menu { position: absolute; top: 2.2rem; left: 0; z-index: 20; display: grid; grid-template-columns: repeat(4, 1.6rem); gap: .3rem; padding: .45rem; background: var(--panel, #fff); border: 1px solid var(--border); border-radius: 8px; box-shadow: 0 8px 24px rgba(0,0,0,.25); }
  .rt-menu[hidden] { display: none; }
  .rt-swatch { width: 1.6rem; height: 1.6rem; border-radius: 50%; border: 1px solid var(--border); cursor: pointer; color: inherit; font-size: .8rem; }
  .rt-edit { min-height: 9rem; padding: .6rem .75rem; outline: none; line-height: 1.5; overflow-wrap: anywhere; }
  .rt-edit:empty::before { content: 'Start typing…'; color: var(--muted); }
  .rt-edit ul, .rt-edit ol { margin: .2rem 0; padding-left: 1.3rem; }
  .rt-edit p { margin: 0 0 .35rem; }
  .ws-field { margin-bottom: .4rem; }
  .ws-score { border: 0; padding: 0; margin: .3rem 0 .6rem; }
  .ws-score .chip input { margin-right: .2rem; }
</style>
<%- include('../partials/foot') %>
