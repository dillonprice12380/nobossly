<%- include('../partials/head') %>
<div class="page-head"><div>
  <h1>🏁 Milestones</h1>
  <p class="muted">The moments that matter, in your own words — first sale, first client, the day you hand in your notice. Reached milestones show on your profile.</p>
</div><a class="btn btn-ghost btn-sm" href="/workspace">Workspace</a></div>
<% if (msg) { %><p class="notice"><%= msg %></p><% } %>
<form method="post" action="/workspace/milestones" class="card cta-row" style="justify-content:flex-start;align-items:flex-end;gap:.5rem;flex-wrap:wrap;max-width:820px">
  <label style="width:4.5rem;margin:0">Emoji<input name="emoji" maxlength="8" value="🏁"></label>
  <label style="flex:1;min-width:220px;margin:0">Milestone<input name="title" maxlength="120" required placeholder="e.g. First paying customer"></label>
  <button class="btn btn-primary btn-sm">Add</button>
</form>
<% if (!milestones.length) { %><div class="card center"><p class="muted" style="margin:0">Nothing marked yet. Add the next one you are working toward.</p></div><% } %>
<div class="card" style="max-width:820px<%= milestones.length ? '' : ';display:none' %>">
  <% milestones.forEach(function (m) { %>
    <div class="milestone-row">
      <form method="post" action="/workspace/milestones/<%= m.id %>/toggle"><button class="btn btn-ghost btn-sm" aria-pressed="<%= !!m.achieved %>" title="<%= m.achieved ? 'Mark as not reached' : 'Mark as reached' %>"><%= m.achieved ? '✅' : '⬜' %></button></form>
      <div style="flex:1"><strong><%= m.emoji %> <%= m.title %></strong><% if (m.achieved && m.date_achieved) { %> <span class="muted small">· reached <%= new Date(m.date_achieved + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span><% } %></div>
      <form method="post" action="/workspace/milestones/<%= m.id %>/delete" onsubmit="return confirm('Delete this milestone?')"><button class="btn-x" aria-label="Delete">×</button></form>
    </div>
  <% }) %>
</div>
<%- include('../partials/foot') %>
