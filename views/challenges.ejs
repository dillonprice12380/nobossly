<%- include('partials/head') %>
<%# Community challenges: weeks members work through side by side. Nothing
    here tells anyone what to build; each person picks their own goal for the
    week, says what got done, and can see who else is in. %>
<div class="page-head">
  <div><h1><svg class="icon icon-lg"><use href="#i-challenge"/></svg> Challenges</h1><p class="muted">Pick your own goal for the week and work on it alongside other members. Say what got done at the end, and see who else is in.</p></div>
</div>
<% if (msg) { %><p class="notice"><%= msg %></p><% } %>

<% if (open.length) { %>
  <div class="card challenge-pin" style="border-left:3px solid var(--accent)">
    <h2>🚩 You're in</h2>
    <% open.forEach(p => {
         const days = Math.ceil((new Date(p.due) - Date.now()) / 86400000);
         const base = p.kind === 'custom' ? '/quests/custom/' + p.ch.id : '/quests/' + p.ch.id;
         const needsNote = p.kind !== 'custom' && p.ch.requires_proof; %>
      <div class="milestone-row">
        <div style="flex:1"><strong><%= p.ch.emoji || '🏁' %> <%= p.ch.title %></strong>
        <p class="muted small">ends <%= p.due %> · <%= days >= 0 ? days + (days === 1 ? ' day left' : ' days left') : Math.abs(days) + (days === -1 ? ' day past' : ' days past') %></p>
        <% if (needsNote) { %>
          <form method="post" action="<%= base %>/finish" style="margin:.35rem 0 0">
            <textarea name="proof_note" rows="2" required minlength="25" placeholder="What you set out to do, and what got done. A few honest sentences."></textarea>
            <button class="btn btn-primary btn-sm" style="margin-top:.35rem">Finish</button>
          </form>
        <% } %>
        </div>
        <div class="cta-row" style="margin:0">
          <% if (!needsNote) { %><form method="post" action="<%= base %>/finish" class="inline"><button class="btn btn-primary btn-sm">Finish</button></form><% } %>
          <% if (p.kind === 'cohort') { %><a class="btn btn-ghost btn-sm" href="/quests/<%= p.ch.id %>/leaderboard">👥 Who's in</a><% } %>
          <form method="post" action="<%= base %>/abandon" class="inline" onsubmit="return confirm('Leave this challenge?')"><button class="btn btn-ghost btn-sm">Leave</button></form>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<div class="card">
  <h2>🗓 Weekly community challenge</h2>
  <p class="muted small">A new one starts every Monday and runs to Sunday night. Your goal is your own.</p>
  <% if (!cohorts.length) { %>
    <p class="muted">The next one is being set up. Check back on Monday.</p>
  <% } else { %>
  <div class="grid">
    <% cohorts.forEach(c => { const a = accMap[c.id];
       const now = Date.now();
       const st = c.starts_at ? new Date(c.starts_at).getTime() : null;
       const en = c.ends_at ? new Date(c.ends_at).getTime() : null;
       const state = (st && now < st) ? 'upcoming' : ((en && now > en) ? 'ended' : 'live');
       const daysTo = ms => Math.max(0, Math.ceil((ms - now) / 86400000));
       const onList = typeof waiting !== 'undefined' && waiting.has(c.id); %>
      <div class="card">
        <div class="idea-top"><span style="font-size:1.6rem"><%= c.emoji || '🚩' %></span></div>
        <h3><%= c.title %></h3>
        <p class="muted"><%= c.description %></p>
        <p>
          <% if (state === 'upcoming') { %><span class="chip">🗓 Starts <%= new Date(c.starts_at).toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric' }) %> (in <%= daysTo(st) %> day<%= daysTo(st) === 1 ? '' : 's' %>)</span>
          <% } else if (state === 'live') { %><span class="chip chip-success">🔴 On now<%= en ? ' — ' + daysTo(en) + ' day' + (daysTo(en) === 1 ? '' : 's') + ' left' : '' %></span>
          <% } else { %><span class="chip">Ended<%= c.ends_at ? ' ' + new Date(c.ends_at).toLocaleDateString() : '' %></span><% } %>
        </p>
        <% if (a && a.status === 'completed') { %>
          <span class="chip chip-success">✅ Finished</span>
        <% } else if (a && a.status === 'active') { %>
          <span class="chip">🎯 You're in (see the top of the page)</span>
        <% } else if (state !== 'ended') { %>
          <div class="cta-row" style="justify-content:flex-start">
            <form method="post" action="/quests/<%= c.id %>/accept" class="inline"><button class="btn btn-primary btn-sm">Join</button></form>
            <% if (state === 'upcoming') { %>
              <form method="post" action="/quests/cohort/<%= c.id %>/remind" class="inline">
                <% if (onList) { %><input type="hidden" name="off" value="1"><button class="btn btn-ghost btn-sm">✓ Reminder set — cancel</button>
                <% } else { %><button class="btn btn-ghost btn-sm">🔔 Remind me when it starts</button><% } %>
              </form>
            <% } %>
          </div>
        <% } %>
        <% if (state !== 'upcoming') { %><p style="margin-top:.5rem"><a class="btn btn-ghost btn-sm" href="/quests/<%= c.id %>/leaderboard">👥 See who's in</a></p><% } %>
      </div>
    <% }) %>
  </div>
  <% } %>
</div>

<% if (finished.length) { %>
  <div class="card">
    <h2>✅ Finished</h2>
    <div class="dash-tools">
      <% finished.forEach(c => { %><span class="dash-tool"><%= c.emoji || '🏁' %> <%= c.title %></span><% }) %>
    </div>
  </div>
<% } %>

<p class="muted small">Want to share what you got done? <a href="/feed">Post it on the feed</a> or <a href="/wins">add it to Results</a>.</p>
<%- include('partials/foot') %>
