<%- include('partials/head') %>
<div class="page-head">
  <div><h1><svg class="icon icon-lg"><use href="#i-challenge"/></svg> Challenges</h1><p class="muted">Quests matched to where you are. Core challenges fit your level; electives fit your business. The weekly sprint carries you between rungs.</p></div>
  <div>
    <span class="chip">⚔️ Level <%= level %></span>
    <% if (streak && streak.days > 0) { %><span class="chip">🔥 <%= streak.days %>-day streak</span><% } %>
  </div>
</div>
<% if (msg) { %><p class="notice"><%= msg %></p><% } %>

<%# Everything in play, pinned first. Core + cohort actives come from
    accMap, personal actives (accepted electives + AI set) from custom. %>
<% const activePinned = []
     .concat(challenges.concat(cohorts).filter(c => accMap[c.id] && accMap[c.id].status === 'active')
       .map(c => ({ kind: c.is_cohort ? 'cohort' : 'core', ch: c, acc: accMap[c.id], due: accMap[c.id].due_date })))
     .concat(custom.filter(c => c.status === 'active')
       .map(c => ({ kind: 'custom', ch: c, acc: c, due: c.due_date })))
     .sort((a, b) => String(a.due || '9999').localeCompare(String(b.due || '9999'))); %>
<% if (activePinned.length) { %>
  <div class="card challenge-pin" style="border-left:3px solid var(--accent)">
    <h2>⚔️ Active challenges</h2>
    <% activePinned.forEach(p => {
         const days = Math.ceil((new Date(p.due) - Date.now()) / 86400000);
         const base = p.kind === 'custom' ? '/challenges/custom/' + p.ch.id : '/challenges/' + p.ch.id;
         const needsProof = p.kind !== 'custom' && p.ch.requires_proof; %>
      <div class="milestone-row">
        <div style="flex:1"><strong><%= p.ch.emoji || '🏁' %> <%= p.ch.title %></strong>
        <p class="muted small">due <%= p.due %> · <%= days >= 0 ? days + ' days left' : Math.abs(days) + ' days overdue' %> · ⚡ <%= p.ch.xp_reward || 0 %> XP<%= p.kind === 'cohort' ? ' · 🚩 cohort' : '' %><%= p.kind === 'custom' ? ' · 🎯 tailored' : '' %><%= needsProof ? ' · 🎮 quest' : '' %></p>
        <% if (needsProof) { %>
          <form method="post" action="<%= base %>/finish" style="margin:.35rem 0 0">
            <textarea name="proof_note" rows="2" required minlength="25" placeholder="Proof note to complete: who, what, result — a few honest sentences."></textarea>
            <button class="btn btn-primary btn-sm" style="margin-top:.35rem">Mark complete</button>
          </form>
        <% } %>
        </div>
        <div class="cta-row" style="margin:0">
          <% if (!needsProof) { %><form method="post" action="<%= base %>/finish" class="inline"><button class="btn btn-primary btn-sm">Mark complete</button></form><% } %>
          <% if (p.kind === 'cohort') { %><a class="btn btn-ghost btn-sm" href="/challenges/<%= p.ch.id %>/leaderboard">🏆</a><% } %>
          <form method="post" action="<%= base %>/abandon" class="inline" onsubmit="return confirm('<%= p.kind === 'cohort' ? 'Leave this cohort?' : 'Abandon this challenge? You can re-accept it later.' %>')"><button class="btn btn-ghost btn-sm"><%= p.kind === 'cohort' ? 'Leave' : 'Abandon' %></button></form>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%# The weekly sprint IS a challenge — the repeating 7-day quest. %>
<div class="card" id="weekly-sprint" style="border-left:3px solid var(--accent)">
  <div class="page-head" style="margin:0 0 .4rem">
    <div><h2>🏃 Your weekly sprint</h2><p class="muted small">The repeating 7-day quest. Every challenge below gets won one sprint at a time.</p></div>
    <% if (sprint) { %><span class="chip"><%= sprint.tasks_done %>/<%= sprint.tasks_total %> tasks</span><% } %>
  </div>
  <% if (sprint) { %>
    <strong>Sprint <%= sprint.sprint_number %>: <%= sprint.theme %></strong>
    <p class="muted small" style="margin:.2rem 0 .6rem"><%= sprint.goal %> · ends <%= sprint.end_date %> · <%= sprint.velocity_pct || 0 %>% velocity</p>
    <div class="progress"><div class="progress-bar" style="width:<%= sprint.velocity_pct || 0 %>%"></div></div>
    <a class="btn btn-primary btn-sm" style="margin-top:.7rem;display:inline-block" href="/dashboard#sprint-card">Open the task board</a>
  <% } else { %>
    <p class="muted">No sprint running. Pick an idea, build its blueprint, and launch a 7-day sprint — that's the engine behind every quest on this page.</p>
    <a class="btn btn-primary btn-sm" href="/ideas">Start a sprint</a>
  <% } %>
</div>

<% if (cohorts && cohorts.length) { %>
  <div class="card">
    <h2>🚩 Cohort challenges</h2>
    <p class="muted small">Everyone starts together, finishes together, and climbs the same leaderboard.</p>
    <div class="grid">
      <% cohorts.forEach(c => { const a = accMap[c.id];
         const now = Date.now();
         const st = c.starts_at ? new Date(c.starts_at).getTime() : null;
         const en = c.ends_at ? new Date(c.ends_at).getTime() : null;
         const state = (st && now < st) ? 'upcoming' : ((en && now > en) ? 'ended' : 'live');
         const daysTo = ms => Math.max(0, Math.ceil((ms - now) / 86400000)); %>
        <div class="card">
          <div class="idea-top"><span style="font-size:1.6rem"><%= c.emoji || '🚩' %></span><span class="chip">⚡ <%= c.xp_reward %> XP</span></div>
          <h3><%= c.title %></h3>
          <p class="muted"><%= c.description %></p>
          <p>
            <% if (state === 'upcoming') { %><span class="chip">🗓 Starts in <%= daysTo(st) %> day<%= daysTo(st) === 1 ? '' : 's' %> — <%= new Date(c.starts_at).toLocaleDateString() %></span>
            <% } else if (state === 'live') { %><span class="chip chip-success">🔴 Live now<%= en ? ' — ' + daysTo(en) + ' day' + (daysTo(en) === 1 ? '' : 's') + ' left' : '' %></span>
            <% } else { %><span class="chip">Ended<%= c.ends_at ? ' ' + new Date(c.ends_at).toLocaleDateString() : '' %></span><% } %>
          </p>
          <% if (a && a.status === 'completed') { %>
            <span class="chip chip-success">✅ Completed</span>
          <% } else if (a && a.status === 'active') { %>
            <span class="chip">🎯 You're in — manage it from the top of the page ⤴</span>
          <% } else if (state !== 'ended') { %>
            <form method="post" action="/challenges/<%= c.id %>/accept" class="inline"><button class="btn btn-primary btn-sm">Join the cohort</button></form>
          <% } %>
          <p style="margin-top:.5rem"><a class="btn btn-ghost btn-sm" href="/challenges/<%= c.id %>/leaderboard">🏆 View leaderboard</a></p>
        </div>
      <% }) %>
    </div>
  </div>
<% } %>

<div class="card">
  <h2>🧭 Core challenges</h2>
  <p class="muted small">The path everyone walks on the way out — filtered to your level. New challenges unlock as you climb; active ones are pinned at the top of the page.</p>
  <div class="grid">
    <% challenges.filter(c => !(accMap[c.id] && accMap[c.id].status === 'active')).forEach(c => { const a = accMap[c.id]; %>
      <div class="card">
        <div class="idea-top"><span style="font-size:1.6rem"><%= c.emoji || '🏁' %></span><span class="chip">⚡ <%= c.xp_reward %> XP</span></div>
        <h3><%= c.title %><%= c.requires_proof ? ' 🎮' : '' %></h3>
        <p class="muted"><%= c.description %></p>
        <% if (c.requires_proof) { %><p class="muted small">Ladder quest — completing it takes a short proof note and posts to the Wins wall.</p><% } %>
        <% if (!a) { %>
          <form method="post" action="/challenges/<%= c.id %>/accept">
            <label class="small">Timeline
              <select name="duration_days"><option value="30">30 days</option><option value="60">60 days</option><option value="90">90 days</option></select>
            </label>
            <button class="btn btn-primary btn-sm">Accept challenge</button>
          </form>
        <% } else if (a.status === 'completed') { %>
          <span class="chip chip-success">✅ Completed</span>
        <% } else { %>
          <form method="post" action="/challenges/<%= c.id %>/accept">
            <span class="chip">Abandoned</span>
            <label class="small">Try again
              <select name="duration_days"><option value="30">30 days</option><option value="60">60 days</option><option value="90">90 days</option></select>
            </label>
            <button class="btn btn-ghost btn-sm">Re-accept</button>
          </form>
        <% } %>
      </div>
    <% }) %>
  </div>
</div>

<div class="card">
  <h2>🎯 Electives for your business</h2>
  <% if (unclassified) { %>
    <p class="muted">Electives are challenges matched to your exact kind of business — its type, industry, customers, and what it promises them. Draw your Compass and pick an idea, and this section fills itself in.</p>
    <a class="btn btn-primary btn-sm" href="/compass">Draw your Compass</a>
  <% } else if (!electives.length) { %>
    <p class="muted">You've taken on every elective that fits your business at this level — impressive. New ones appear as you level up<%= paid ? ' and as the AI writes more for your profile' : '' %>.</p>
  <% } else { %>
    <p class="muted small">Matched to your business type, industry, and customers. Accept the ones that move your needle.</p>
    <div class="grid">
      <% electives.forEach(t => { %>
        <div class="card">
          <div class="idea-top"><span style="font-size:1.6rem"><%= t.emoji || '🏁' %></span><span class="chip">⚡ <%= t.xp_reward %> XP</span></div>
          <h3><%= t.title %></h3>
          <p class="muted"><%= t.description %></p>
          <% if (t.source === 'ai') { %><p class="muted small">✨ Written for your exact business profile.</p><% } %>
          <form method="post" action="/challenges/tailored/<%= t.id %>/accept">
            <label class="small">Timeline
              <select name="duration_days">
                <option value="30" <%= t.suggested_days === 30 ? 'selected' : '' %>>30 days</option>
                <option value="60" <%= t.suggested_days === 60 ? 'selected' : '' %>>60 days</option>
                <option value="90" <%= t.suggested_days === 90 ? 'selected' : '' %>>90 days</option>
              </select>
            </label>
            <button class="btn btn-primary btn-sm">Accept elective</button>
          </form>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<% const nonActiveCustom = custom.filter(c => c.status !== 'active'); %>
<% if (nonActiveCustom.length || paid) { %>
  <div class="card">
    <div class="page-head" style="margin:0 0 .5rem">
      <div><h2>🛡️ Your personal challenges</h2><p class="muted small">Electives you've taken and your AI-generated set. Active ones are pinned at the top of the page.</p></div>
      <% if (paid) { %><form method="post" action="/challenges/generate"><button class="btn btn-primary btn-sm"><%= custom.length ? '↻ Regenerate AI set' : 'Generate AI set' %></button></form><% } %>
    </div>
    <% if (!nonActiveCustom.length) { %>
      <p class="muted"><%= custom.length ? 'Everything here is active and pinned above.' : 'Nothing here yet. Accept an elective above' + (paid ? ', or click Generate to build a set from your blueprint.' : '.') %></p>
    <% } else { %>
      <div class="grid">
        <% nonActiveCustom.forEach(c => { %>
          <div class="card">
            <div class="idea-top"><span style="font-size:1.6rem"><%= c.emoji || '🏁' %></span><span class="chip">⚡ <%= c.xp_reward %> XP</span></div>
            <h3><%= c.title %></h3>
            <p class="muted"><%= c.description %></p>
            <% if (c.status === 'completed') { %>
              <span class="chip chip-success">✅ Completed</span>
            <% } else { %>
              <form method="post" action="/challenges/custom/<%= c.id %>/accept">
                <% if (c.status === 'abandoned') { %><span class="chip">Abandoned</span><% } %>
                <label class="small">Timeline
                  <select name="duration_days">
                    <option value="30" <%= c.suggested_days === 30 ? 'selected' : '' %>>30 days</option>
                    <option value="60" <%= c.suggested_days === 60 ? 'selected' : '' %>>60 days</option>
                    <option value="90" <%= c.suggested_days === 90 ? 'selected' : '' %>>90 days</option>
                  </select>
                </label>
                <button class="btn btn-primary btn-sm"><%= c.status === 'abandoned' ? 'Re-accept' : 'Accept challenge' %></button>
              </form>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
<% } else { %>
  <div class="card" style="border:1px dashed var(--border)">
    <h2>✨ Want an AI challenge set built for YOUR business?</h2>
    <p class="muted">Upgrade to get a full AI-generated challenge set drawn from your launch blueprint — plus badges and awards pinned to your public profile when you complete them.</p>
    <a class="btn btn-primary btn-sm" href="/pricing">See plans</a>
  </div>
<% } %>
<%- include('partials/foot') %>
