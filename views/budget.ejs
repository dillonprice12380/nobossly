<%- include('partials/head') %>
<div class="page-head">
  <div><h1>💰 Money</h1><p class="muted"><%= monthLabel %> — what came in, what went out, what to keep aside, and the tools for prices and costs.</p></div>
  <div class="cta-row" style="margin:0"><a class="btn btn-ghost btn-sm" href="/budget/history">History</a><a class="btn btn-ghost btn-sm" href="/budget/export">Export for tax time</a></div>
</div>

<% if (typeof msg !== 'undefined' && msg) { %><p class="notice"><%= msg %></p><% } %>

<% const $m = n => '$' + Number(n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); %>
<% claims.forEach(c => { if (c.kind !== 'quest' && !flags.trophies) return; %>
  <div class="card" style="border-left:3px solid var(--accent-2)">
    <p style="margin:0">🏆 Your income log shows <strong><%= c.title %></strong><% if (flags.ladder) { %> — Level <%= c.level %>, <%= c.rung %> on your path<% } %>. <a href="<%= c.href %>"><%= c.kind === 'quest' ? 'Complete the quest' : 'Claim the trophy' %></a>: <%= c.how %>.</p>
  </div>
<% }) %>

<%- include('partials/money_overview') %>

<div class="card">
  <div class="grid-2" style="align-items:start">
    <div>
      <h3 style="margin-top:0" id="income">💵 Income</h3>
      <p class="muted small" style="margin:-.3rem 0 .6rem">Log a payment when it lands. <%= $m(incomeSum.total) %> logged in all.</p>
      <form method="post" action="/budget/income">
        <div class="form-grid-2">
          <label>Amount ($)<input name="amount" inputmode="decimal" required></label>
          <label>Date<input name="date" type="date" value="<%= new Date().toISOString().slice(0,10) %>" max="<%= new Date().toISOString().slice(0,10) %>"></label>
        </div>
        <label>From<input name="source" maxlength="80" placeholder="Client, platform, sale…"></label>
        <label class="check" style="display:flex;gap:.45rem;align-items:center;margin:.2rem 0 .6rem"><input type="checkbox" name="recurring" value="1"> Recurring <span class="muted small">(a subscription or retainer payment)</span></label>
        <button class="btn btn-primary">Log income</button>
      </form>
      <p class="small" style="margin:.5rem 0 0"><a href="/budget/import">📥 Import payments from a CSV</a> <span class="muted">(bank, Stripe, PayPal, Etsy, Shopify…)</span></p>
      <p class="small" style="margin:.3rem 0 0">🔌 <a href="/budget/connect">Connect Stripe, Shopify, Gumroad, Square or your bank</a> <span class="muted">to log payments by themselves</span><% if (typeof stripeConn !== 'undefined' && stripeConn) { %> <span class="muted">· Stripe <%= stripeConn.status === 'error' ? 'needs attention' : 'connected' %></span><% } %></p>
      <% if (typeof bankWaiting !== 'undefined' && bankWaiting) { %><p class="small" style="margin:.3rem 0 0">🏦 <a href="/budget/review"><strong><%= bankWaiting %></strong> bank transaction<%= bankWaiting === 1 ? '' : 's' %> to sort</a></p><% } %>
      <p class="muted small">Put about <strong><%= setAsideRate %>%</strong> of each payment aside for tax<%= isPremium ? '' : ' — a rough US figure' %>. <% if (isPremium) { %><a href="/tools/tax">Your quarterly estimates →</a><% } else if (flags.premium) { %><a href="/pricing">Premium</a> turns this into quarterly estimates.<% } %></p>
    </div>
    <div>
      <h3 style="margin-top:0">Recent payments <a class="muted small" style="font-weight:400;margin-left:.4rem" href="/budget/history?type=in">All →</a></h3>
      <% if (!incomeLog.length) { %><p class="muted small">Nothing logged yet. Every payment counts<% if (flags.ladder) { %> — the first sale is a rung on every path<% } %>.</p><% } %>
      <table class="table small" style="width:100%">
        <% incomeLog.slice(0, 8).forEach(e => { %>
          <tr>
            <td><%= new Date(e.entry_date + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></td>
            <td><a class="money-edit" href="/budget/entry/in/<%= e.id %>?back=/budget" title="Edit"><strong><%= $m(e.amount) %></strong></a><% if (e.is_recurring) { %> <span class="chip" style="font-size:.7rem">Recurring</span><% } %><% if (e.source) { %><br><span class="muted small"><%= e.source %></span><% } %></td>
            <td><form method="post" action="/budget/income/<%= e.id %>/delete" class="inline" onsubmit="return confirm('Delete this payment?')"><button class="btn-x" title="Delete">×</button></form></td>
          </tr>
        <% }) %>
      </table>
    </div>
  </div>
</div>

<% if (typeof suggestion !== 'undefined' && suggestion.length) { %>
  <div class="card" style="border-left:3px solid var(--accent)">
    <h3 style="margin-top:0">Start from what you already told us</h3>
    <p class="muted">You said you could put in <strong><%= launchBudget %></strong> to start. Here is that spread over your first <%= starterMonths %> months, in the categories your path actually spends on. Nothing is locked in — change or delete any of it.</p>
    <ul class="feature-list" style="margin:.4rem 0 .8rem">
      <% suggestion.forEach(r => { %><li><%= r.category %> — $<%= r.monthly_limit %>/mo</li><% }) %>
    </ul>
    <form method="post" action="/budget/start" class="inline"><button class="btn btn-primary btn-sm">Use this as my starting budget</button></form>
    <span class="muted small" style="margin-left:.5rem">or set your own below</span>
  </div>
<% } %>

<div class="grid-2" id="expenses">
  <div class="card">
    <h3>Spending this month</h3>
    <p class="big-number">$<%= totalSpent.toFixed(2) %> <span class="muted small">spent<%= totalBudget ? ' of $' + totalBudget.toFixed(2) + ' budgeted' : '' %></span></p>
    <% if (totalBudget) { const pct = Math.min(100, Math.round(totalSpent / totalBudget * 100)); %>
      <div class="budget-bar"><div class="budget-fill <%= pct >= 100 ? 'over' : pct >= 80 ? 'warn' : '' %>" style="width:<%= pct %>%"></div></div>
      <p class="muted small"><%= pct %>% of monthly budget used</p>
    <% } %>
    <% if (typeof launchBudgetUsd !== 'undefined' && launchBudgetUsd) { %>
      <p class="muted small" style="margin-top:.35rem">Your launch budget: <strong>$<%= launchBudgetUsd.toLocaleString() %></strong> — the <%= launchBudget %> you said you could put in to start.</p>
    <% } %>
    <h3 style="margin-top:1rem">Categories</h3>
    <% if (!cats.length) { %>
      <% if (typeof suggestion !== 'undefined' && suggestion.length) { %>
        <p class="muted small">Nothing set yet — take the starting budget above, or add your own category below.</p>
      <% } else if (typeof launchBudget !== 'undefined' && launchBudget) { %>
        <p class="muted small">You said you could put in <strong><%= launchBudget %></strong> to start. Add the categories you will actually spend it on below.</p>
      <% } else { %>
        <p class="muted small">Add a category and limit below to start budgeting.</p>
      <% } %>
    <% } %>
    <% cats.forEach(cat => { const b = budgets.find(x => x.category === cat); const spent = spentByCat[cat] || 0; const lim = b ? Number(b.monthly_limit) : 0; const pct = lim ? Math.min(100, Math.round(spent / lim * 100)) : 0; %>
      <div class="budget-row">
        <div class="budget-row-head">
          <strong><%= cat %></strong>
          <span class="muted small">$<%= spent.toFixed(2) %><%= lim ? ' / $' + lim.toFixed(2) : '' %></span>
          <% if (b) { %><form method="post" action="/budget/category/<%= b.id %>/delete" class="inline"><button class="btn-x" title="Remove category">×</button></form><% } %>
        </div>
        <% if (lim) { %><div class="budget-bar"><div class="budget-fill <%= spent > lim ? 'over' : pct >= 80 ? 'warn' : '' %>" style="width:<%= pct %>%"></div></div><% } %>
      </div>
    <% }) %>
    <form method="post" action="/budget/category" class="inline-form" style="margin-top:.8rem">
      <input name="category" placeholder="Category (e.g. Marketing & Advertising)" required maxlength="40" list="std-cats">
      <datalist id="std-cats"><% budgetCategories.forEach(c => { %><option value="<%= c %>"><% }) %></datalist>
      <input name="monthly_limit" type="number" step="0.01" min="0" placeholder="Monthly limit $">
      <button class="btn btn-ghost btn-sm">Set budget</button>
    </form>
  </div>

  <div class="card">
    <h3>Add expense</h3>
    <form method="post" action="/budget/expense">
      <div class="form-grid-2">
        <label>Amount ($)<input name="amount" type="number" step="0.01" min="0.01" required></label>
        <label>Date<input name="spent_at" type="date" value="<%= new Date().toISOString().slice(0,10) %>"></label>
      </div>
      <label>Category
        <select name="category" id="exp-cat" required>
          <option value="" disabled selected>Choose a category…</option>
          <% if (cats.length) { %><optgroup label="Your categories"><% cats.forEach(c => { %><option value="<%= c %>"><%= c %></option><% }) %></optgroup><% } %>
          <optgroup label="Common categories">
            <% const stdCats = budgetCategories; %>
            <% stdCats.filter(c => !cats.includes(c)).forEach(c => { %><option value="<%= c %>"><%= c %></option><% }) %>
          </optgroup>
          <option value="__other">Other…</option>
        </select>
      </label>
      <label id="exp-cat-other" style="display:none">Custom category<input name="category_other" maxlength="40" placeholder="Type your own category"></label>
      <label>Note (optional)<input name="note" maxlength="200" placeholder="What was it for?"></label>
      <button class="btn btn-primary">Add expense</button>
    </form>
    <h3 style="margin-top:1.2rem">Recent expenses <a class="muted small" style="font-weight:400;margin-left:.4rem" href="/budget/history?type=out">All →</a></h3>
    <% if (!expenses.length) { %><p class="muted small">Nothing logged this month yet.</p><% } %>
    <table class="table small" style="width:100%">
      <% expenses.slice(0, 12).forEach(e => { %>
        <tr>
          <td><%= new Date(e.spent_at + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></td>
          <td><a class="money-edit" href="/budget/entry/out/<%= e.id %>?back=/budget" title="Edit"><strong><%= e.category %></strong></a><% if (e.recurring_id) { %> <span class="chip" style="font-size:.7rem">Monthly</span><% } %><% if (e.note) { %><br><span class="muted small"><%= e.note %></span><% } %></td>
          <td>$<%= Number(e.amount).toFixed(2) %></td>
          <td><form method="post" action="/budget/expense/<%= e.id %>/delete" class="inline"><button class="btn-x" title="Delete">×</button></form></td>
        </tr>
      <% }) %>
    </table>
  </div>
</div>
<%- include('partials/money_monthly') %>

<% if (typeof moneyTools !== 'undefined' && moneyTools) { %>
  <h2 class="money-section">Money tools</h2>
  <div class="grid money-tools">
    <% moneyTools.mine.forEach(function (t) { %>
      <a class="card money-tool" href="<%= t.href %>"><div class="money-head"><span class="money-emoji"><%= t.emoji %></span><strong><%= t.label %></strong></div><p class="muted small" style="margin:.3rem 0 0"><%= t.blurb %></p></a>
    <% }) %>
    <% (moneyMetrics || []).forEach(function (m) { %>
      <a class="card money-tool" href="/workspace/metrics/<%= m.key %>"><div class="money-head"><span class="money-emoji">📈</span><strong><%= m.label %></strong></div><p class="muted small" style="margin:.3rem 0 0">Logged each <%= m.period %><%= m.help ? ' · ' + m.help : '' %></p></a>
    <% }) %>
  </div>
  <% if (moneyTools.more.length) { %>
    <details class="money-more"><summary><strong>More money worksheets</strong> <span class="muted small">(<%= moneyTools.more.length %>, from other paths)</span></summary>
      <div class="grid" style="margin-top:.6rem">
        <% moneyTools.more.forEach(function (t) { %>
          <a class="card money-tool" href="<%= t.href %>"><div class="money-head"><span class="money-emoji"><%= t.emoji %></span><strong><%= t.label %></strong></div><p class="muted small" style="margin:.3rem 0 0"><%= t.blurb %></p></a>
        <% }) %>
      </div>
    </details>
  <% } %>
<% } %>
<style>
  .money-section { font-size: 1.05rem; margin: 1.2rem 0 .5rem; }
  .money-tool { display: block; color: inherit; text-decoration: none; }
  .money-tool:hover { border-color: var(--accent); }
  .money-head { display: flex; gap: .5rem; align-items: center; }
  .money-emoji { font-size: 1.4rem; }
  .money-more { margin: .4rem 0 1rem; }
  .money-edit { color: inherit; text-decoration: none; border-bottom: 1px dotted var(--border); }
  .money-edit:hover { color: var(--accent); border-color: var(--accent); }
</style>

<script>
  (function () {
    var sel = document.getElementById('exp-cat');
    var other = document.getElementById('exp-cat-other');
    if (!sel || !other) return;
    sel.addEventListener('change', function () {
      var show = sel.value === '__other';
      other.style.display = show ? '' : 'none';
      other.querySelector('input').required = show;
      if (show) other.querySelector('input').focus();
    });
  })();
</script>
<%- include('partials/foot') %>
