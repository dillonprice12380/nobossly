<%- include('partials/head') %>
<div class="page-head">
  <div><h1>Hey <%= profile.display_name || 'there' %> <svg class="icon icon-lg"><use href="#i-wave"/></svg></h1>
  <p class="muted"><%= levelInfo.current.emoji %> Level <%= profile.current_level || 1 %> — <%= levelInfo.current.title %>
  <% if (typeof ladder !== 'undefined' && ladder) { %>
    <% if (ladder.xpNeeded > 0) { %> · <%= ladder.xpNeeded %> XP to <%= ladder.next.title %>
    <% } else if (!ladder.questsMet) { %> · XP ready for <%= ladder.next.title %> — <%= ladder.needMin - ladder.doneCount %> quest<%= (ladder.needMin - ladder.doneCount) === 1 ? '' : 's' %> to go
    <% } %>
  <% } else if (levelInfo.next) { %> · <%= Math.max(0, levelInfo.next.xp_required - (profile.xp_total||0)) %> XP to <%= levelInfo.next.title %><% } %></p></div>
  <%# The check-in no longer waits on a sprint — it is the daily loop for everyone. %>
  <% if (!checkinToday) { %><a class="btn btn-primary" href="/dashboard/checkin">📝 Daily check-in (+15 XP)</a>
  <% } else { %><span class="chip">✅ Checked in today · 🔥 <%= profile.streak_days || 0 %> day streak</span><% } %>
</div>

<%# The questionnaire is no longer a wall between signup and the product, so it
    has to earn attention here instead. It sits above the stats because it is
    the Level 1 quest: nothing else on this page can be finished without it. %>
<% if (typeof needsQuestionnaire !== 'undefined' && needsQuestionnaire) { %>
  <div class="card" style="border-color:var(--accent);display:flex;gap:1rem;align-items:center;flex-wrap:wrap;justify-content:space-between">
    <div style="flex:1;min-width:16rem">
      <h2 style="margin:0 0 .2rem">🧭 Start here: answer seven questions</h2>
      <p class="muted small" style="margin:0">They are what your Compass is drawn from — your archetype, the hours you actually have after work, and the territories where you hold an edge. Answering them is your Level 1 quest, so Level 2 stays locked until you do. About two minutes.</p>
    </div>
    <a class="btn btn-primary" style="flex:none" href="/questionnaire">Answer them →</a>
  </div>
<% } %>

<%# data-count animates the number up from zero on load (app.js). The element
    still contains the real value, so it is correct with JS off and for anything
    reading the page rather than watching it. %>
<div class="stat-row">
  <div class="stat card"><span class="stat-num" data-count="<%= profile.xp_total || 0 %>"><%= profile.xp_total || 0 %></span><span class="muted">XP</span></div>
  <div class="stat card"><span class="stat-num"><svg class="icon <%= (profile.streak_days || 0) >= 3 ? 'flame-live' : '' %>" style="color:#f59e0b"><use href="#i-flame"/></svg> <span data-count="<%= profile.streak_days || 0 %>"><%= profile.streak_days || 0 %></span></span><span class="muted">day check-in streak</span></div>
  <div class="stat card"><span class="stat-num" data-count="<%= profile.tasks_completed || 0 %>"><%= profile.tasks_completed || 0 %></span><span class="muted">tasks done</span></div>
  <% if (sprint) { %><div class="stat card"><span class="stat-num"><span data-count="<%= sprint.velocity_pct || 0 %>"><%= sprint.velocity_pct || 0 %></span>%</span><span class="muted">sprint velocity</span></div><% } %>
</div>

<%# The Ladder. No view ever rendered a level's requirements or its unlock text,
    so the spine of the whole game was invisible: players saw an XP bar implying
    "fill this and advance" while the real gate stayed hidden. %>
<% if (typeof ladder !== 'undefined' && ladder) { %>
  <div class="card">
    <div class="page-head" style="margin:0 0 .5rem">
      <div><h2><%= ladder.next.emoji %> Next rung: Level <%= ladder.next.level %> — <%= ladder.next.title %></h2>
      <p class="muted small" style="margin:.15rem 0 0">
        <% if (ladder.blocker === 'both') { %>Needs <%= ladder.xpNeeded %> more XP and the quests below.
        <% } else if (ladder.blocker === 'quests') { %>You have the XP. These are what's left.
        <% } else if (ladder.blocker === 'xp') { %>Quests done — <%= ladder.xpNeeded %> XP to go.
        <% } else { %>Everything is done. Your next action levels you up.<% } %>
      </p></div>
      <span class="chip"><%= ladder.doneCount %>/<%= ladder.needMin %> quests</span>
    </div>

    <% if (ladder.quests.length) { %>
      <ul class="task-list" style="margin:0">
        <% ladder.quests.forEach(function (q) { %>
          <li class="task <%= q.done ? 'done' : '' %>">
            <span class="task-check" aria-hidden="true" style="cursor:default"><%= q.done ? '✓' : '' %></span>
            <div style="flex:1">
              <strong><%= q.title %></strong>
              <p class="muted small" style="margin:.1rem 0 0"><%= q.type === 'challenge' ? 'Challenge' : 'Real-world milestone' %><%= q.done ? ' · done' : '' %></p>
            </div>
            <% if (!q.done) { %><a class="btn btn-ghost btn-sm" style="flex:none" href="<%= q.href %>">Go</a><% } %>
          </li>
        <% }) %>
      </ul>
      <% if (ladder.needMin < ladder.quests.length) { %>
        <p class="muted small" style="margin:.5rem 0 0">Any <%= ladder.needMin %> of these <%= ladder.quests.length %> will do.</p>
      <% } %>
    <% } %>

    <%# What the rung actually gives, and honestly how. Unlocks marked "arranged
        with you" are real-world commitments a person fulfils — the app is not
        pretending to have granted them. %>
    <% if ((ladder.unlocks || []).length || ladder.next.unlock_text) { %>
      <div style="border-top:1px solid var(--border);margin:.7rem 0 0;padding-top:.6rem">
        <% if ((ladder.unlocks || []).length) { %>
          <% ladder.unlocks.forEach(function (u) { %>
            <p class="small" style="margin:.25rem 0">
              <%= u.kind === 'live' ? '🎁' : '🤝' %> <strong><%= u.label %></strong>
              <span class="muted"><%= u.detail %></span>
              <% if (u.kind !== 'live') { %><span class="chip" style="font-size:.68rem">arranged with you</span><% } %>
            </p>
          <% }) %>
        <% } else { %>
          <p class="muted small" style="margin:0">🎁 <%= ladder.next.unlock_text %></p>
        <% } %>
      </div>
    <% } %>
  </div>
<% } %>

<%# Active quests pinned first — the weekly sprint and every accepted
    challenge (curated AND tailored) in one card at the top of the board. %>
<% if ((typeof pinned !== 'undefined' && pinned.length) || sprint) { %>
  <div class="card challenge-pin">
    <h2><svg class="icon icon-lg"><use href="#i-challenge"/></svg> Active quests</h2>
    <% if (sprint) { %>
      <div class="milestone-row">
        <div><strong>🏃 Sprint <%= sprint.sprint_number %>: <%= sprint.theme %></strong>
        <p class="muted small">7-day quest · <%= sprint.tasks_done %>/<%= sprint.tasks_total %> tasks · <%= sprint.velocity_pct || 0 %>% velocity · ends <%= sprint.end_date %></p></div>
        <div class="cta-row" style="margin:0"><a class="btn btn-ghost btn-sm" href="#sprint-card">Tasks ↓</a></div>
      </div>
    <% } %>
    <% (typeof pinned !== 'undefined' ? pinned : []).forEach(a => { const days = Math.ceil((new Date(a.due_date) - Date.now()) / 86400000); const base = a.custom ? '/challenges/custom/' + a.id : '/challenges/' + a.challenge_id; const needsProof = !a.custom && a.challenge.requires_proof; %>
      <div class="milestone-row">
        <div style="flex:1"><strong><%= (a.challenge.emoji || '🏁') %> <%= a.challenge.title || 'Challenge' %></strong>
        <p class="muted small"><%= a.duration_days %>-day challenge · due <%= a.due_date %> · <%= days >= 0 ? days + ' days left' : Math.abs(days) + ' days overdue' %> · ⚡ <%= a.challenge.xp_reward || 0 %> XP<%= a.custom ? ' · 🎯 tailored' : '' %><%= needsProof ? ' · 🎮 quest' : '' %></p>
        <% if (needsProof) { %>
          <form method="post" action="<%= base %>/finish" style="margin:.35rem 0 0">
            <input type="hidden" name="from" value="dashboard">
            <textarea name="proof_note" rows="2" required minlength="25" placeholder="Proof note to complete: who, what, result — a few honest sentences."></textarea>
            <button class="btn btn-primary btn-sm" style="margin-top:.35rem">Done!</button>
          </form>
        <% } %>
        </div>
        <div class="cta-row" style="margin:0">
          <% if (!needsProof) { %><form method="post" action="<%= base %>/finish" class="inline"><input type="hidden" name="from" value="dashboard"><button class="btn btn-primary btn-sm">Done!</button></form><% } %>
          <form method="post" action="<%= base %>/abandon" class="inline" onsubmit="return confirm('Abandon this challenge? It comes off your board and you can re-accept it later.')"><input type="hidden" name="from" value="dashboard"><button class="btn btn-ghost btn-sm">Abandon</button></form>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%# The Coach: rule-matched tips for exactly where this member is right now. %>
<% if (typeof coach !== 'undefined' && coach && coach.length) { %>
  <div class="card coach-card" style="border-left:3px solid var(--accent)">
    <h2>🎙️ Coach</h2>
    <% coach.forEach(function (t) { %>
      <div class="milestone-row">
        <p style="margin:.25rem 0"><%= t.message %></p>
        <% if (t.cta_href) { %><a class="btn btn-ghost btn-sm" style="flex:none" href="<%= t.cta_href %>"><%= t.cta_label || 'Go' %></a><% } %>
      </div>
    <% }) %>
  </div>
<% } %>

<div class="card">
  <h2><svg class="icon icon-lg"><use href="#i-suitcase"/></svg> Workspace</h2>
  <div class="workspace-grid">
    <a class="ws-tile" href="/compass"><span class="ws-emoji">🧭</span><strong>Compass</strong><span class="muted small">Start here — your map out</span></a>
    <a class="ws-tile" href="/ideas"><span class="ws-emoji"><svg class="icon"><use href="#i-idea"/></svg></span><strong>My ideas</strong><span class="muted small">Drafts &amp; advisor verdicts</span></a>
    <a class="ws-tile" href="/tasks"><span class="ws-emoji"><svg class="icon"><use href="#i-task"/></svg></span><strong>Tasks</strong><span class="muted small">Your kanban board</span></a>
    <a class="ws-tile" href="/milestones"><span class="ws-emoji"><svg class="icon"><use href="#i-milestone"/></svg></span><strong>Milestones</strong><span class="muted small">Mark your wins</span></a>
    <a class="ws-tile" href="/challenges"><span class="ws-emoji"><svg class="icon"><use href="#i-challenge"/></svg></span><strong>Challenges</strong><span class="muted small">Your quest board</span></a>
    <a class="ws-tile" href="/budget"><span class="ws-emoji">💰</span><strong>Budget</strong><span class="muted small">Expenses &amp; budgets</span></a>
    <a class="ws-tile" href="/reviews"><span class="ws-emoji"><svg class="icon"><use href="#i-team"/></svg></span><strong>Peer review</strong><span class="muted small">Give and get feedback</span></a>
  </div>
</div>

<% if (sprint) { %>
  <div class="card" id="sprint-card">
    <div class="page-head">
      <div><h2><svg class="icon icon-lg"><use href="#i-target"/></svg> Sprint <%= sprint.sprint_number %>: <%= sprint.theme %></h2>
      <p class="muted"><%= sprint.goal %> · <%= sprint.start_date %> → <%= sprint.end_date %></p></div>
      <span class="chip"><%= sprint.tasks_done %>/<%= sprint.tasks_total %> done</span>
    </div>
    <div class="progress"><div class="progress-bar" style="width:<%= sprint.velocity_pct || 0 %>%"></div></div>
    <ul class="task-list">
      <% tasks.forEach(t => { %>
        <li class="task <%= t.status === 'done' ? 'done' : '' %>" data-id="<%= t.id %>">
          <button class="task-check" title="Toggle"><%= t.status === 'done' ? '✓' : '' %></button>
          <div><strong><%= t.title %></strong> <span class="tag tag-<%= t.priority %>"><%= t.priority %></span>
          <p class="muted small"><%= t.description %></p></div>
        </li>
      <% }) %>
    </ul>
  </div>
<% } else { %>
  <div class="card center">
    <h2>No active sprint</h2>
    <%# Three different states, three different next moves. Sending someone with
        no Compass to a list of ideas they do not have was the old dead end. %>
    <% if (ideas.length) { %>
      <p>Build your idea's blueprint, then launch your first 7-day sprint.</p>
      <a class="btn btn-primary" style="margin-top:.9rem;display:inline-block" href="/ideas">Open my ideas</a>
    <% } else if (typeof hasCompass !== 'undefined' && hasCompass) { %>
      <p>Your Compass is drawn. Now draft your idea in your own words and run it past your advisor — it stress-tests the idea against your own fit test before you spend a week on it.</p>
      <a class="btn btn-primary" style="margin-top:.9rem;display:inline-block" href="/compass">✍️ Draft my idea</a>
    <% } else { %>
      <p>It starts with your Compass — your archetype, your real constraints, and the territories where you hold an edge. Everything after it is built on what it tells you.</p>
      <a class="btn btn-primary" style="margin-top:.9rem;display:inline-block" href="/compass">🧭 Draw my Compass</a>
    <% } %>
  </div>
<% } %>

<% if (ideas.length) { %>
  <h2>Your ideas</h2>
  <p class="muted small" style="margin:-.4rem 0 .6rem">Drafted by you, stress-tested by your Compass advisor.</p>
  <div class="grid">
    <% ideas.forEach(i => { %>
      <a class="card idea-card" href="/ideas/<%= i.id %>">
        <h3><%= i.is_favorited ? '⭐ ' : '' %><%= i.name %></h3>
        <p class="muted"><%= i.tagline %></p>
        <span class="chip">🎯 <%= i.success_likelihood %>%</span>
      </a>
    <% }) %>
  </div>
<% } %>
<% if (typeof analytics !== 'undefined' && analytics) { %>
<section class="card analytics">
  <h2>📈 Your progress <span class="muted small">last 8 weeks</span></h2>
  <div class="analytics-stats">
    <div><span class="big-number"><%= analytics.totalDone %></span><span class="muted small">tasks completed</span></div>
    <div><span class="big-number"><%= analytics.totalXp %></span><span class="muted small">XP earned</span></div>
    <div><span class="big-number"><%= analytics.openTasks %></span><span class="muted small">tasks open</span></div>
    <div><span class="big-number"><%= profile.streak_days || 0 %>🔥</span><span class="muted small">day streak</span></div>
  </div>
  <div class="charts">
    <div class="chart">
      <h3 class="small muted">Tasks completed / week</h3>
      <svg viewBox="0 0 320 110" class="bar-chart" role="img" aria-label="Tasks completed per week">
        <% analytics.weeks.forEach((w, i) => { const h = Math.round(w.tasksDone / analytics.maxTasks * 80); %>
          <rect x="<%= 10 + i * 39 %>" y="<%= 90 - h %>" width="26" height="<%= Math.max(h, 2) %>" rx="4" class="bar"></rect>
          <text x="<%= 23 + i * 39 %>" y="<%= 84 - h %>" text-anchor="middle" class="bar-val"><%= w.tasksDone || '' %></text>
          <text x="<%= 23 + i * 39 %>" y="104" text-anchor="middle" class="bar-label"><%= w.label %></text>
        <% }) %>
      </svg>
    </div>
    <div class="chart">
      <h3 class="small muted">XP earned / week</h3>
      <svg viewBox="0 0 320 110" class="bar-chart" role="img" aria-label="XP earned per week">
        <% analytics.weeks.forEach((w, i) => { const h = Math.round(w.xp / analytics.maxXp * 80); %>
          <rect x="<%= 10 + i * 39 %>" y="<%= 90 - h %>" width="26" height="<%= Math.max(h, 2) %>" rx="4" class="bar bar-alt"></rect>
          <text x="<%= 23 + i * 39 %>" y="<%= 84 - h %>" text-anchor="middle" class="bar-val"><%= w.xp || '' %></text>
          <text x="<%= 23 + i * 39 %>" y="104" text-anchor="middle" class="bar-label"><%= w.label %></text>
        <% }) %>
      </svg>
    </div>
  </div>
</section>
<% } %>
<%- include('partials/foot') %>
