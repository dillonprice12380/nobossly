<%- include('partials/head') %>
<div class="page-head">
  <div><h1>Hey <%= profile.display_name || 'there' %> <svg class="icon icon-lg"><use href="#i-wave"/></svg></h1>
  <% if (flags.ladder) { %><p class="muted"><%= levelInfo.current.emoji %> Level <%= profile.current_level || 1 %> — <%= levelInfo.current.title %>
  <% if (typeof ladder !== 'undefined' && ladder) { %>
    <% if (ladder.xpNeeded > 0) { %> · <%= ladder.xpNeeded %> XP to <%= ladder.next.title %>
    <% } else if (!ladder.questsMet) { %> · XP ready for <%= ladder.next.title %> — <%= ladder.needMin - ladder.doneCount %> quest<%= (ladder.needMin - ladder.doneCount) === 1 ? '' : 's' %> to go
    <% } %>
  <% } else if (levelInfo.next) { %> · <%= Math.max(0, levelInfo.next.xp_required - (profile.xp_total||0)) %> XP to <%= levelInfo.next.title %><% } %></p><% } %>
  <% if (typeof yourPath !== 'undefined' && yourPath) { %>
    <p class="muted small" style="margin:.15rem 0 0">
      <%= yourPath.emoji %> <%= yourPath.label %>
      <a class="muted" style="margin-left:.4rem" href="/choose-path">change</a>
    </p>
  <% } %></div>
  <% if (flags.sprints) { %>
  <% if (!checkinToday) { %><a class="btn btn-primary" href="/dashboard/checkin">📝 Daily check-in<% if (flags.ladder) { %> (+15 XP)<% } %></a>
  <% } else { %><span class="chip">✅ Checked in today · 🔥 <%= profile.streak_days || 0 %> day streak</span><% } %>
  <% } %>
</div>

<% if (typeof msg !== 'undefined' && msg) { %><p class="notice"><%= msg %></p><% } %>

<%# Onboarding first: until a member has a path and a set-up dashboard, that is
    the one thing to do. The first-week checklist only lists what is left. %>
<%# Picking a path is the only onboarding step left. It sits above everything
    else because the dashboard, the tools and the news are all set up for it. %>
<% if (typeof needsPath !== 'undefined' && needsPath) { %>
  <div class="card" style="border-color:var(--accent);display:flex;gap:1rem;align-items:center;flex-wrap:wrap;justify-content:space-between">
    <div style="flex:1;min-width:16rem">
      <h2 style="margin:0 0 .2rem">🧭 Start here: pick your path</h2>
      <p class="muted small" style="margin:0">Your dashboard, workspace tools and news are set up for the kind of business you pick. Takes ten seconds.</p>
    </div>
    <a class="btn btn-primary" style="flex:none" href="/choose-path">Choose →</a>
  </div>
<% } %>
<% if (typeof needsSetup !== 'undefined' && needsSetup && yourPath) { %>
  <div class="card" style="border-color:var(--accent);display:flex;gap:1rem;align-items:center;flex-wrap:wrap;justify-content:space-between">
    <div style="flex:1;min-width:16rem">
      <h2 style="margin:0 0 .2rem"><%= yourPath.emoji %> Set up your <%= yourPath.label.toLowerCase() %> dashboard</h2>
      <p class="muted small" style="margin:0">A few questions so your dashboard shows the tools and numbers that matter for what you are building. About a minute.</p>
    </div>
    <a class="btn btn-primary" style="flex:none" href="/choose-path/setup">Set up →</a>
  </div>
<% } %>

<% if (typeof checklist !== 'undefined' && checklist) { %>
  <div class="card dash-first" style="border-left:3px solid var(--accent-2)">
    <div class="page-head" style="margin:0 0 .4rem">
      <div><h2 style="margin:0">✅ Your first week</h2><p class="muted small" style="margin:.15rem 0 0"><%= checklist.done %> of <%= checklist.total %> done</p></div>
    </div>
    <div class="progress"><div class="progress-bar" style="width:<%= Math.round(100 * checklist.done / checklist.total) %>%"></div></div>
    <div class="dash-first-steps">
      <% checklist.steps.filter(function (s) { return !s.done; }).forEach(function (s) { %>
        <a class="dash-step" href="<%= s.href %>"><span>⬜ <%= s.label %></span><span class="dash-step-cta"><%= s.cta %> →</span></a>
      <% }) %>
    </div>
  </div>
<% } %>

<%# The stat strip only earns its place when there is more than one number. %>
<% if (flags.ladder || flags.sprints) { %>
<div class="stat-row">
  <% if (flags.ladder) { %><div class="stat card"><span class="stat-num" data-count="<%= profile.xp_total || 0 %>"><%= profile.xp_total || 0 %></span><span class="muted">XP</span></div><% } %>
  <% if (flags.sprints) { %><div class="stat card"><span class="stat-num"><svg class="icon <%= (profile.streak_days || 0) >= 3 ? 'flame-live' : '' %>" style="color:#f59e0b"><use href="#i-flame"/></svg> <span data-count="<%= profile.streak_days || 0 %>"><%= profile.streak_days || 0 %></span></span><span class="muted">day check-in streak</span></div><% } %>
  <div class="stat card"><span class="stat-num" data-count="<%= profile.tasks_completed || 0 %>"><%= profile.tasks_completed || 0 %></span><span class="muted">tasks done</span></div>
  <% if (flags.sprints && sprint) { %><div class="stat card"><span class="stat-num"><span data-count="<%= sprint.velocity_pct || 0 %>"><%= sprint.velocity_pct || 0 %></span>%</span><span class="muted">sprint velocity</span></div><% } %>
</div>
<% } %>

<%# The sections, in the member's own order (src/dashboard_layout.js; they
    choose it at /dashboard/customize). Across the top: money and the week
    ahead. Below: the work on the left, quick glances on the right. On a phone
    it is one column, ordered by --m-order: the top cards, Got paid, the work,
    then the rest. A section with nothing to show leaves no gap. %>
<% var L = (typeof layout !== 'undefined' && layout) ? layout : { top: [], main: [], side: [], mobileOrder: {} };
   var section = function (k) {
     var h = include('dashboard/sections/' + k);
     return h.trim() ? '<div class="dash-sec dash-sec-' + k + '" style="--m-order:' + (L.mobileOrder[k] || 99) + '">' + h + '</div>' : '';
   };
   var top = L.top.map(section).filter(Boolean); %>
<div class="dash">
<% if (top.length) { %><div class="dash-top<%= top.length === 1 ? ' one' : '' %>"><%- top.join('\n') %></div><% } %>
<div class="dash-main">
<%- L.main.map(section).join('\n') %>
</div>
<aside class="dash-side">
<%- L.side.map(section).join('\n') %>
</aside>
</div>
<p class="muted small dash-customize"><a class="muted" href="/dashboard/customize">⚙️ Customize this dashboard</a></p>


<% if (flags.analytics && typeof analytics !== 'undefined' && analytics) { %>
<details class="card analytics">
  <summary><h2 style="display:inline">📈 Your progress <span class="muted small">last 8 weeks</span></h2></summary>
  <div class="analytics-stats">
    <div><span class="big-number"><%= analytics.totalDone %></span><span class="muted small">tasks completed</span></div>
    <% if (flags.ladder) { %><div><span class="big-number"><%= analytics.totalXp %></span><span class="muted small">XP earned</span></div><% } %>
    <div><span class="big-number"><%= analytics.openTasks %></span><span class="muted small">tasks open</span></div>
    <% if (flags.sprints) { %><div><span class="big-number"><%= profile.streak_days || 0 %>🔥</span><span class="muted small">day streak</span></div><% } %>
  </div>
  <div class="charts">
    <div class="chart">
      <h3 class="small muted">Tasks completed / week</h3>
      <svg viewBox="0 0 320 110" class="bar-chart" role="img" aria-label="Tasks completed per week">
        <% analytics.weeks.forEach((w, i) => { const h = Math.round(w.tasksDone / analytics.maxTasks * 80); %>
          <rect x="<%= 10 + i * 39 %>" y="<%= 90 - h %>" width="26" height="<%= Math.max(h, 2) %>" rx="4" class="bar"></rect>
          <text x="<%= 23 + i * 39 %>" y="<%= 84 - h %>" text-anchor="middle" class="bar-val"><%= w.tasksDone || '' %></text>
          <text x="<%= 23 + i * 39 %>" y="104" text-anchor="middle" class="bar-label"><%= w.label %></text>
        <% }) %>
      </svg>
    </div>
    <% if (flags.ladder) { %><div class="chart">
      <h3 class="small muted">XP earned / week</h3>
      <svg viewBox="0 0 320 110" class="bar-chart" role="img" aria-label="XP earned per week">
        <% analytics.weeks.forEach((w, i) => { const h = Math.round(w.xp / analytics.maxXp * 80); %>
          <rect x="<%= 10 + i * 39 %>" y="<%= 90 - h %>" width="26" height="<%= Math.max(h, 2) %>" rx="4" class="bar bar-alt"></rect>
          <text x="<%= 23 + i * 39 %>" y="<%= 84 - h %>" text-anchor="middle" class="bar-val"><%= w.xp || '' %></text>
          <text x="<%= 23 + i * 39 %>" y="104" text-anchor="middle" class="bar-label"><%= w.label %></text>
        <% }) %>
      </svg>
    </div><% } %>
  </div>
</details>
<% } %>
<%- include('partials/foot') %>
