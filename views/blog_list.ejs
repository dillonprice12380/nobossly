<%- include('partials/head') %>
<div class="page-head"><div><h1><svg class="icon icon-lg"><use href="#i-blog"/></svg> Blog</h1></div></div>

<form class="list-search" id="list-search-form" method="get" action="/blog" role="search"
      data-endpoint="/api/blog/search" data-list-url="/blog">
  <label class="sr-only" for="list-search">Search posts</label>
  <input type="search" id="list-search" name="q" value="<%= q %>" placeholder="Search posts…"
         autocomplete="off" spellcheck="false">
  <noscript><button class="btn btn-primary" type="submit">Search</button></noscript>
</form>

<div id="list-results" aria-live="polite">
<%- include('partials/post_list') %>
</div>

<script src="/js/list-search.js?v=1"></script>
<%- include('partials/foot') %>
