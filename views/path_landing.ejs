<%- include('partials/head') %>
<%
  var mk = def.marketing;
  var start = '/signup?path=' + def.slug;
%>

<section class="pl-hero">
  <div>
    <a class="chip" href="/paths">← All paths</a>
    <h1 style="margin:.7rem 0 0"><%= def.emoji %> <%= mk.headline %></h1>
    <p class="lead" style="margin-left:0"><%= mk.subhead %></p>
    <div class="cta-row" style="justify-content:flex-start">
      <a class="btn btn-primary btn-lg" href="<%= start %>">Start as a <%= def.label.toLowerCase() %> →</a>
      <a class="btn btn-ghost btn-lg" href="/community">See the community</a>
    </div>
    <p class="muted small" style="margin-top:.7rem">Free, no card. Pick this path, answer a few questions, and your dashboard is ready in about a minute.</p>
  </div>
</section>

<section class="card">
  <h2>Sound familiar?</h2>
  <ul class="pain-list">
    <% mk.pains.forEach(function (t) { %><li><%= t %></li><% }) %>
  </ul>
  <p class="pl-truth"><%= mk.truth %></p>
</section>

<% if (subpaths && subpaths.length) { %>
<section>
  <h2>Which kind of <%= def.label.toLowerCase() %>?</h2>
  <p class="muted">This path covers all of it &mdash; nobody is forced into a box.</p>
  <div class="sub-row">
    <% subpaths.forEach(function (sp) { %><span class="sub-chip"><%= sp.label %></span><% }) %>
  </div>
</section>
<% } %>

<% if (typeof dash !== 'undefined' && dash) { %>
<section class="card">
  <h2>📊 Your dashboard on this path</h2>
  <p class="muted">Built for what a <%= def.label.toLowerCase() %> actually needs to track. Everything is private to you.</p>
  <div class="dash-grid">
    <div>
      <h3>Where you are</h3>
      <ol class="stage-list"><% dash.stages.forEach(function (s) { %><li><%= s %></li><% }) %></ol>
      <p class="muted small" style="margin:.4rem 0 0">Say which fits and your dashboard shows the numbers and boards for it.</p>
    </div>
    <div>
      <% if (dash.numbers.length) { %><h3>Your numbers</h3><ul class="dash-list"><% dash.numbers.forEach(function (n) { %><li><%= n %></li><% }) %></ul><% } %>
      <% if (dash.boards.length) { %><h3>Boards</h3><ul class="dash-list"><% dash.boards.forEach(function (b) { %><li><%= b.emoji %> <%= b.label %></li><% }) %></ul><% } %>
    </div>
    <div>
      <% if (dash.checklists.length) { %><h3>Checklist templates</h3><ul class="dash-list"><% dash.checklists.forEach(function (c) { %><li><%= c %></li><% }) %></ul><% } %>
      <% if (dash.tools.length) { %><h3>Tools up front</h3><ul class="dash-list"><% dash.tools.forEach(function (t) { %><li><%= t.emoji %> <%= t.label %></li><% }) %></ul><% } %>
    </div>
  </div>
  <p class="muted small" style="margin:.8rem 0 0">Every other tool stays open to you too. Your path only decides what comes first.</p>
  <a class="btn btn-ghost" style="margin-top:.8rem;display:inline-block" href="/how-it-works">How the whole thing works →</a>
</section>
<% } %>

<%- include('partials/affiliate_picks', { picks: affiliates.forPath(def.slug), from: 'path:' + def.slug }) %>

<section class="cta-band">
  <h2>Start as a <%= def.label.toLowerCase() %>.</h2>
  <p class="muted">Free, no card. Your dashboard is ready in about a minute, and you can switch paths any time.</p>
  <a class="btn btn-primary btn-lg" style="margin-top:1.1rem;display:inline-block" href="<%= start %>">Start as a <%= def.label.toLowerCase() %> →</a>
</section>

<section>
  <h3 class="small muted">Building something else?</h3>
  <div class="other-paths">
    <% others.forEach(function (p) { %>
      <a class="chip" href="/paths/<%= p.slug %>"><%= p.emoji %> <%= p.label %></a>
    <% }) %>
  </div>
</section>

<style>
  .pl-hero { padding: clamp(1.5rem, 5vw, 3rem) 0 .5rem; max-width: 46rem; }
  .pl-hero h1 { font-size: clamp(1.8rem, 4.6vw, 2.9rem); line-height: 1.1; letter-spacing: -.02em; text-wrap: balance; }
  .pain-list { list-style: none; padding: 0; margin: .6rem 0 0; display: flex; flex-direction: column; gap: .55rem; }
  .pain-list li { padding-left: 1.5rem; position: relative; }
  .pain-list li::before { content: "—"; position: absolute; left: 0; color: var(--muted); }
  .pl-truth {
    margin: 1rem 0 0; padding: .85rem 1rem; border-left: 3px solid var(--accent);
    background: rgba(16,185,129,.08); border-radius: 0 10px 10px 0; font-weight: 500;
  }
  .sub-row { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: .9rem; }
  .sub-chip {
    font-size: .88rem; padding: .35rem .7rem; border-radius: 999px;
    background: var(--panel-2); border: 1px solid var(--border);
  }
  .sub-chip:last-child { border-style: dashed; color: var(--muted); }
  .dash-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1rem; margin-top: .8rem; }
  .dash-grid h3 { font-size: .95rem; margin: .2rem 0 .4rem; }
  .dash-list, .stage-list { margin: 0 0 .6rem; padding-left: 1.2rem; }
  .dash-list li, .stage-list li { margin: .15rem 0; }
  .other-paths { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: .5rem; }
</style>
<%- include('partials/foot') %>
