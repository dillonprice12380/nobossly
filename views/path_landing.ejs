<%- include('partials/head') %>
<%
  var mk = def.marketing;
  var start = '/signup?path=' + def.slug;
%>

<section class="pl-hero">
  <div>
    <a class="chip" href="/paths">← All paths</a>
    <h1 style="margin:.7rem 0 0"><%= def.emoji %> <%= mk.headline %></h1>
    <p class="lead" style="margin-left:0"><%= mk.subhead %></p>
    <div class="cta-row" style="justify-content:flex-start">
      <a class="btn btn-primary btn-lg" href="<%= start %>">Start as a <%= def.label.toLowerCase() %> →</a>
      <a class="btn btn-ghost btn-lg" href="/community">See the community</a>
    </div>
    <p class="muted small" style="margin-top:.7rem">Free, forever. Pick this path and you're straight into your quest board. No card, no waiting on a report.</p>
  </div>
</section>

<section class="card">
  <h2>Sound familiar?</h2>
  <ul class="pain-list">
    <% mk.pains.forEach(function (t) { %><li><%= t %></li><% }) %>
  </ul>
  <p class="pl-truth"><%= mk.truth %></p>
</section>

<% if (subpaths && subpaths.length) { %>
<section>
  <h2>Which kind of <%= def.label.toLowerCase() %>?</h2>
  <p class="muted">This path covers all of it &mdash; nobody is forced into a box.</p>
  <div class="sub-row">
    <% subpaths.forEach(function (sp) { %><span class="sub-chip"><%= sp.label %></span><% }) %>
  </div>
</section>
<% } %>

<% if (mk.bar) { %>
<section class="card bar-card">
  <h2>📐 The number this path turns on</h2>
  <p class="pl-bar"><%= mk.bar %></p>
  <p class="muted small" style="margin:.6rem 0 0">Rules of thumb, not laws &mdash; but a plan with no number in it is not a plan you can tell you are winning.</p>
</section>
<% } %>

<% if (challenges.length) { %>
<section>
  <h2>⚔️ Quests built for this path</h2>
  <p class="muted">Alongside the ten shared rungs everyone climbs.</p>
  <div class="grid">
    <% challenges.forEach(function (c) { %>
      <div class="card ch-card">
        <div class="ch-top"><span class="ch-emoji"><%= c.emoji %></span><span class="chip">+<%= c.xp_reward %> XP · <%= c.suggested_days %> days</span></div>
        <h3><%= c.title %></h3>
        <p class="muted small"><%= c.description %></p>
      </div>
    <% }) %>
  </div>
</section>
<% } %>

<section class="card">
  <h2>🎮 Your ten rungs, named for this path</h2>
  <p class="muted">Every path climbs the same ten stages for the same XP, but a plumber's fifth rung is not a podcaster's. XP alone can never buy one &mdash; each gates on something that happened in the real world.</p>
  <div class="rung-row">
    <% rungs.forEach(function (r) { %>
      <span class="rung-pill<%= (r.level === 5 || r.level === 9) ? ' is-key' : '' %>"><%= r.emoji %> <%= r.title %><%= r.level === 5 ? ' — first money' : (r.level === 9 ? ' — the job ends' : '') %></span>
    <% }) %>
  </div>
  <a class="btn btn-ghost" style="margin-top:1rem;display:inline-block" href="/how-it-works">How the whole thing works →</a>
</section>

<section class="cta-band">
  <h2>Start as a <%= def.label.toLowerCase() %>.</h2>
  <p class="muted">One choice, and you're straight into the quest board and the ladder. Tonight, after work. You can switch paths any time from your dashboard.</p>
  <a class="btn btn-primary btn-lg" style="margin-top:1.1rem;display:inline-block" href="<%= start %>">Start as a <%= def.label.toLowerCase() %> →</a>
</section>

<section>
  <h3 class="small muted">Building something else?</h3>
  <div class="other-paths">
    <% others.forEach(function (p) { %>
      <a class="chip" href="/paths/<%= p.slug %>"><%= p.emoji %> <%= p.label %></a>
    <% }) %>
  </div>
</section>

<style>
  .pl-hero { padding: clamp(1.5rem, 5vw, 3rem) 0 .5rem; max-width: 46rem; }
  .pl-hero h1 { font-size: clamp(1.8rem, 4.6vw, 2.9rem); line-height: 1.1; letter-spacing: -.02em; text-wrap: balance; }
  .pain-list { list-style: none; padding: 0; margin: .6rem 0 0; display: flex; flex-direction: column; gap: .55rem; }
  .pain-list li { padding-left: 1.5rem; position: relative; }
  .pain-list li::before { content: "—"; position: absolute; left: 0; color: var(--muted); }
  .pl-truth {
    margin: 1rem 0 0; padding: .85rem 1rem; border-left: 3px solid var(--accent);
    background: rgba(16,185,129,.08); border-radius: 0 10px 10px 0; font-weight: 500;
  }
  .bar-card { border-left: 3px solid var(--accent); }
  .pl-bar { margin: .6rem 0 0; font-size: 1.05rem; line-height: 1.55; }
  .sub-row { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: .9rem; }
  .sub-chip {
    font-size: .88rem; padding: .35rem .7rem; border-radius: 999px;
    background: var(--panel-2); border: 1px solid var(--border);
  }
  .sub-chip:last-child { border-style: dashed; color: var(--muted); }
  .ch-card { display: flex; flex-direction: column; gap: .3rem; }
  .ch-top { display: flex; align-items: center; justify-content: space-between; gap: .5rem; }
  .ch-emoji { font-size: 1.5rem; }
  .ch-card h3 { margin: 0; font-size: 1.02rem; }
  .rung-row { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .8rem; }
  .rung-pill {
    font-size: .82rem; padding: .3rem .6rem; border-radius: 999px;
    background: var(--panel-2); border: 1px solid var(--border); color: var(--muted); white-space: nowrap;
  }
  .rung-pill.is-key { color: var(--accent); border-color: var(--accent); font-weight: 600; }
  .other-paths { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: .5rem; }
</style>
<%- include('partials/foot') %>
