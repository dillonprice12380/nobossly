<%- include('partials/head') %>
<%# Connect one affiliate network (src/connections/affiliates/<key>.js). %>
<% locals.when = function (t) { return t ? new Date(t).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) : 'not yet'; };
   locals.pend = conn ? pendingText(conn) : ''; %>
<div class="page-head">
  <div><h1><%= net.emoji %> Connect <%= net.label %></h1><p class="muted"><%= net.blurb %> Approved commissions go into your income log by themselves. NoBossly only reads; it cannot change anything in your <%= net.label %> account.</p></div>
  <a class="btn btn-ghost btn-sm" href="/budget/connect#affiliate">← Connections</a>
</div>
<% if (msg) { %><p class="notice"><%= msg %></p><% } %>
<% if (!ready) { %>
  <div class="card center"><h2>Being set up</h2><p class="muted">Connecting affiliate networks is being switched on. Check back shortly.</p></div>
<% } else { %>
  <% if (conn) { %>
    <div class="card af-conn" style="border-left:3px solid <%= conn.status === 'error' ? 'var(--danger)' : 'var(--accent-2)' %>">
      <div class="page-head" style="margin:0">
        <div><h2 style="margin:0">Connected<%= conn.account_label ? ': ' + conn.account_label : '' %></h2>
          <p class="muted small" style="margin:.25rem 0 0">Last synced <%= when(conn.last_synced_at) %> · <%= conn.imported_count || 0 %> commission<%= conn.imported_count === 1 ? '' : 's' %> brought in · syncs every <%= everyHours %> hours</p></div>
        <div class="cta-row" style="margin:0">
          <% if (canSync) { %><form method="post" action="/budget/connect/affiliate/<%= net.key %>/sync" class="inline"><button class="btn btn-primary btn-sm">Sync now</button></form><% } %>
          <form method="post" action="/budget/connect/affiliate/<%= net.key %>/disconnect" class="inline" onsubmit="return confirm('Disconnect <%= net.label %>? Commissions already logged stay.')"><button class="btn btn-ghost btn-sm">Disconnect</button></form>
        </div>
      </div>
      <% if (pend) { %><p class="af-pending"><strong><%= pend %></strong> <span class="muted small">across <%= conn.pending.count %> commission<%= conn.pending.count === 1 ? '' : 's' %> the network has not approved yet. They come in once approved.</span></p><% } %>
      <% if (conn.status === 'error' && conn.last_error) { %><p class="small" style="margin:.7rem 0 0;color:var(--danger)"><%= conn.last_error %></p><% } %>
    </div>
  <% } %>
  <div class="grid-2">
    <div class="card">
      <h2 style="margin-top:0">Where to find it</h2>
      <ol class="small" style="margin:0;padding-left:1.1rem;line-height:1.75">
        <% net.where.forEach(function (w) { %><li><%= w %></li><% }) %>
      </ol>
    </div>
    <form class="card" method="post" action="/budget/connect/affiliate/<%= net.key %>" autocomplete="off">
      <h2 style="margin-top:0"><%= conn ? 'Replace the details' : 'Paste it here' %></h2>
      <% net.fields.forEach(function (f) { %>
        <label><%= f.label %>
          <input name="<%= f.name %>" type="<%= f.secret ? 'password' : 'text' %>"<%= /optional/i.test(f.label) ? '' : ' required' %> spellcheck="false" autocomplete="off" placeholder="<%= f.placeholder || '' %>">
          <% if (f.help) { %><span class="muted small"><%= f.help %></span><% } %>
        </label>
      <% }) %>
      <button class="btn btn-primary" style="margin-top:.4rem"><%= conn ? 'Replace' : 'Connect ' + net.label %></button>
      <ul class="muted small" style="margin:.9rem 0 0;padding-left:1.1rem;line-height:1.6">
        <li>We check it with <%= net.label %>, then store it encrypted. Nobody can read it back, including you.</li>
        <li>Approved commissions come in as income. Pending ones show above as on the way; reversed ones are taken back out.</li>
        <li>Commissions you already logged by hand or from a CSV are recognised and not added twice.</li>
      </ul>
    </form>
  </div>
  <p class="muted small">Other networks: <% others.forEach(function (n, i) { %><%= i ? ' · ' : '' %><a href="/budget/connect/affiliate/<%= n.key %>"><%= n.label %></a><% }) %> · <a href="/budget/import">Amazon Associates (CSV)</a></p>
<% } %>
<style>
  .af-pending { margin: .7rem 0 0; padding: .55rem .75rem; border-radius: 10px; background: rgba(16,185,129,.08); }
</style>
<%- include('partials/foot') %>
