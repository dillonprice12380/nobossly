<%# The path's own dashboard (src/path_dashboards panelFor): where you say you
    are, your numbers and your boards. Pass it as `panel`, with `pathInfo`
    ({ label, emoji }). %>
<% var P = panel; %>
<section class="card path-panel">
  <div class="page-head" style="margin:0 0 .4rem">
    <div>
      <h2 style="margin:0"><%= pathInfo.emoji %> Your <%= pathInfo.label.toLowerCase() %> dashboard</h2>
      <p class="muted small" style="margin:.15rem 0 0"><%= P.intro %></p>
    </div>
    <a class="btn btn-ghost btn-sm" href="/choose-path/setup">Path settings</a>
  </div>

  <% if (P.notReady) { %><p class="muted small">Your boards and logs are being set up — they open shortly.</p><% } %>

  <p class="small" style="margin:.2rem 0 0">
    <% if (P.stage.current) { %>Where you are: <span class="chip"><%= P.stage.current %></span> <a class="muted" href="/choose-path/setup">change</a>
    <% } else { %><span class="muted">Say where you are in <a href="/choose-path/setup">path settings</a> and your numbers and boards fit it.</span><% } %>
  </p>

  <% if (P.north || P.northBoard || P.supporting.length) { %>
    <h3 class="pp-h">Your numbers</h3>
    <div class="grid">
      <% if (P.north) { %><div class="pp-north"><%- include('metric_card', { card: P.north }) %></div><% } %>
      <% if (P.northBoard) { %><div class="pp-north"><%- include('board_summary', { summary: P.northBoard }) %></div><% } %>
      <% P.supporting.forEach(function (c) { %><%- include('metric_card', { card: c }) %><% }) %>
    </div>
  <% } %>

  <% if (P.boards.length) { %>
    <h3 class="pp-h">Your boards <a class="small" style="font-weight:normal" href="/workspace/calendar">Calendar →</a></h3>
    <div class="grid"><% P.boards.forEach(function (b) { %><%- include('board_summary', { summary: b }) %><% }) %></div>
  <% } %>

  <p class="muted small" style="margin:.8rem 0 0">Checklist templates are in <a href="/workspace">your workspace</a> when you want one.</p>
</section>
<style>
  .path-panel { border-top: 3px solid var(--accent); }
  .pp-h { font-size: 1rem; margin: 1rem 0 .4rem; display: flex; gap: .6rem; align-items: baseline; }
  .pp-north > .card { border-color: var(--accent); }
</style>
