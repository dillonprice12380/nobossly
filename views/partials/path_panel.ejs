<%# The path's own dashboard (src/path_dashboards panelFor): where you are, your
    number, your boards and your checklists. Pass it as `panel`, with `pathInfo`
    ({ label, emoji }). %>
<% var P = panel; %>
<section class="card path-panel">
  <div class="page-head" style="margin:0 0 .4rem">
    <div>
      <h2 style="margin:0"><%= pathInfo.emoji %> Your <%= pathInfo.label.toLowerCase() %> dashboard</h2>
      <p class="muted small" style="margin:.15rem 0 0"><%= P.intro %></p>
    </div>
    <a class="btn btn-ghost btn-sm" href="/choose-path/setup">Path settings</a>
  </div>

  <% if (P.notReady) { %><p class="muted small">Your boards and logs are being set up — they open shortly.</p><% } %>

  <div class="pp-stage">
    <ol class="pp-steps" aria-label="Stages">
      <% P.stage.list.forEach(function (s, i) { %>
        <li class="<%= i < P.stage.index ? 'done' : i === P.stage.index ? 'here' : '' %>"><span><%= s %></span></li>
      <% }) %>
    </ol>
    <% if (P.stage.current) { %>
      <p style="margin:.5rem 0 0"><strong>Next:</strong> <%= P.stage.next %><% if (P.stage.href) { %> <a href="<%= P.stage.href %>">Go →</a><% } %></p>
    <% } else { %>
      <p style="margin:.5rem 0 0"><a href="/choose-path/setup">Tell us where you are</a> and this shows your next real-world step.</p>
    <% } %>
  </div>

  <% if (P.north || P.northBoard || P.supporting.length) { %>
    <h3 class="pp-h">Your numbers</h3>
    <div class="grid">
      <% if (P.north) { %><div class="pp-north"><%- include('metric_card', { card: P.north }) %></div><% } %>
      <% if (P.northBoard) { %><div class="pp-north"><%- include('board_summary', { summary: P.northBoard }) %></div><% } %>
      <% P.supporting.forEach(function (c) { %><%- include('metric_card', { card: c }) %><% }) %>
    </div>
  <% } %>

  <% if (P.boards.length) { %>
    <h3 class="pp-h">Your boards <a class="small" style="font-weight:normal" href="/workspace/calendar">Calendar →</a></h3>
    <div class="grid"><% P.boards.forEach(function (b) { %><%- include('board_summary', { summary: b }) %><% }) %></div>
  <% } %>

  <% if (P.checklists.length) { %>
    <h3 class="pp-h">Checklists</h3>
    <div class="grid"><% P.checklists.forEach(function (c) { %><%- include('checklist_card', { progress: c }) %><% }) %></div>
  <% } %>
</section>
<style>
  .path-panel { border-top: 3px solid var(--accent); }
  .pp-h { font-size: 1rem; margin: 1rem 0 .4rem; display: flex; gap: .6rem; align-items: baseline; }
  .pp-steps { list-style: none; padding: 0; margin: .3rem 0 0; display: flex; flex-wrap: wrap; gap: .3rem; counter-reset: st; }
  .pp-steps li { counter-increment: st; font-size: .82rem; padding: .25rem .6rem; border: 1px solid var(--border); border-radius: 99px; color: var(--muted); }
  .pp-steps li::before { content: counter(st) ". "; }
  .pp-steps li.done { color: inherit; border-color: var(--accent-2); }
  .pp-steps li.here { color: inherit; border-color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, transparent); font-weight: 600; }
  .pp-north > .card { border-color: var(--accent); }
</style>
