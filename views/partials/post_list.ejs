<% if (q) { %>
  <p class="list-count muted small"><%= total %> result<%= total === 1 ? '' : 's' %> for "<%= q %>"</p>
<% } %>

<% if (!posts.length) { %>
  <div class="card center">
    <p><%= q ? 'No matches for "' + q + '". Try a different term.' : emptyMsg %></p>
  </div>
<% } else { %>
  <% posts.forEach(p => { %>
    <a class="card post-card" href="<%= base %><%= p.slug %>">
      <div class="post-card-top">
        <% if (p.featured_image) { %><img class="post-card-img" src="<%= p.featured_image %>" alt="" loading="lazy"><% } else { %><div class="post-card-img post-card-img-empty"><%= emptyIcon %></div><% } %>
        <h3 class="post-card-title"><%= p.title %></h3>
      </div>
      <% if (showMeta) { %>
        <p class="muted small post-card-meta">
          <%= p.published_at ? new Date(p.published_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '' %>
          <% if (p.author_id && amap[p.author_id]) { %> · By <%= amap[p.author_id] %><% } %>
          · 👁 <%= p.view_count || 0 %> views
        </p>
      <% } %>
      <% if (p.excerpt) { %><p class="muted post-card-excerpt"><%= p.excerpt %></p><% } %>
    </a>
  <% }) %>
<% } %>

<% if (pages > 1) { %>
  <% const href = n => listUrl + '?' + (q ? 'q=' + encodeURIComponent(q) + '&' : '') + 'page=' + n; %>
  <nav class="pager" aria-label="Pagination">
    <% if (page > 1) { %>
      <a class="pager-btn" href="<%= href(page - 1) %>" data-page="<%= page - 1 %>" rel="prev">← Prev</a>
    <% } else { %>
      <span class="pager-btn is-disabled" aria-disabled="true">← Prev</span>
    <% } %>

    <span class="pager-pages">
      <% pager.forEach(n => { %>
        <% if (n === null) { %>
          <span class="pager-gap">…</span>
        <% } else if (n === page) { %>
          <span class="pager-num is-current" aria-current="page"><%= n %></span>
        <% } else { %>
          <a class="pager-num" href="<%= href(n) %>" data-page="<%= n %>"><%= n %></a>
        <% } %>
      <% }) %>
    </span>

    <% if (page < pages) { %>
      <a class="pager-btn" href="<%= href(page + 1) %>" data-page="<%= page + 1 %>" rel="next">Next →</a>
    <% } else { %>
      <span class="pager-btn is-disabled" aria-disabled="true">Next →</span>
    <% } %>
  </nav>
<% } %>
