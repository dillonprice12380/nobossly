<% var hasToc = typeof toc !== 'undefined' && toc && toc.length >= 2; %>
<% var isBlog = post.type === 'blog'; var isGuide = post.type === 'guide'; %>
<div class="post-layout <%= sidebar ? 'with-sidebar' : '' %>">
  <article class="article">
    <% if (!isGuide && post.featured_image) { %><img class="featured-img" src="<%= post.featured_image %>" alt="<%= post.title %>"><% } %>
    <h1><%= post.title %></h1>
    <% if (isBlog) { %>
      <div class="post-meta-row">
        <span class="muted small"><% if (typeof authorName !== 'undefined' && authorName) { %>By <strong><%= authorName %></strong> · <% } %><%= post.published_at ? new Date(post.published_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '' %></span>
        <% if (typeof shareUrl !== 'undefined' && shareUrl) { %><%- include('share_buttons', { shareUrl, shareTitle: post.title }) %><% } %>
      </div>
    <% } else if (isGuide) { %>
      <div class="post-meta-row">
        <% if (typeof shareUrl !== 'undefined' && shareUrl) { %><%- include('share_buttons', { shareUrl, shareTitle: post.title }) %><% } %>
      </div>
    <% } %>
    <% if (hasToc) { %>
      <details class="toc toc-accordion toc-inline-mobile">
        <summary>📑 Contents</summary>
        <ol class="toc-list">
          <% toc.forEach(t => { %><li class="toc-l<%= t.level %>"><a href="#<%= t.id %>"><%= t.text %></a></li><% }) %>
        </ol>
      </details>
    <% } %>
    <div class="article-body"><%- post.body %></div>
    <% if (isGuide || isBlog) { %>
      <div class="cta-band">
<%# The entry point is the path now, not the Compass — nine of them, each with
    its own questions, its own ten rungs and its own quests. Sending a reader
    straight to /paths shows them that before asking for an email. %>
        <p><strong>You just read the manual — now find your path.</strong> A plumber and a podcaster do not leave their jobs the same way, so NoBossly does not ask them the same questions. Pick one of nine paths and everything changes with it: what you are asked, the number your idea is held to, the quests you get, and the ten rungs you climb — named for the work you actually do.</p>
        <a class="btn btn-primary" style="margin-top:1rem;display:inline-block" href="<%= user ? '/dashboard' : '/paths' %>"><%= user ? 'Back to the climb →' : 'Find your path — free →' %></a>
      </div>
    <% } %>
  </article>
  <% if (sidebar) { %>
    <aside class="post-sidebar">
      <% if (hasToc) { %>
        <details class="toc toc-accordion">
          <summary>📑 Contents</summary>
          <ol class="toc-list">
            <% toc.forEach(t => { %><li class="toc-l<%= t.level %>"><a href="#<%= t.id %>"><%= t.text %></a></li><% }) %>
          </ol>
        </details>
      <% } %>
      <% if (sidebar.config.html_top) { %><div class="sidebar-html"><%- sidebar.config.html_top %></div><% } %>
      <% if (sidebar.config.show_similar && sidebar.similar.length) { %>
        <div class="card">
          <h3>Keep reading</h3>
          <% sidebar.similar.forEach(s => { %>
            <a class="similar-post" href="<%= sidebar.base + s.slug %>">
              <% if (s.featured_image) { %><img src="<%= s.featured_image %>" alt="" loading="lazy"><% } %>
              <span><%= s.title %></span>
            </a>
          <% }) %>
        </div>
      <% } %>
      <% if (sidebar.config.html_middle) { %><div class="sidebar-html"><%- sidebar.config.html_middle %></div><% } %>
      <% if (sidebar.config.html_bottom) { %><div class="sidebar-html"><%- sidebar.config.html_bottom %></div><% } %>
    </aside>
  <% } %>
</div>
