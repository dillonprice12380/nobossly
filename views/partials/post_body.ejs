<% var hasToc = typeof toc !== 'undefined' && toc && toc.length >= 2; %>
<% var isBlog = post.type === 'blog'; var isGuide = post.type === 'guide'; %>
<div class="post-layout <%= sidebar ? 'with-sidebar' : '' %>">
  <article class="article">
    <% if (!isGuide && post.featured_image) { %><img class="featured-img" src="<%= post.featured_image %>" alt="<%= post.title %>"><% } %>
    <h1><%= post.title %></h1>
    <% if (isBlog) { %>
      <div class="post-meta-row">
        <span class="muted small"><% if (typeof authorName !== 'undefined' && authorName) { %>By <strong><%= authorName %></strong> · <% } %><%= post.published_at ? new Date(post.published_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '' %></span>
        <% if (typeof shareUrl !== 'undefined' && shareUrl) { %><%- include('share_buttons', { shareUrl, shareTitle: post.title }) %><% } %>
      </div>
    <% } else if (isGuide) { %>
      <% var reviewed = post.reviewed_at || post.updated_at || post.published_at; %>
      <div class="post-meta-row">
        <% if (reviewed) { %><span class="muted small"><%= post.reviewed_at ? 'Last reviewed' : 'Last updated' %> <%= new Date(reviewed).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span><% } %>
        <% if (typeof shareUrl !== 'undefined' && shareUrl) { %><%- include('share_buttons', { shareUrl, shareTitle: post.title }) %><% } %>
      </div>
      <p class="guide-disclaimer small">ℹ️ General information, not legal, tax or financial advice. Rules change and differ by place — check the official source linked in the guide, or ask a professional, before you act on it.</p>
    <% } %>
    <% if (hasToc) { %>
      <details class="toc toc-accordion toc-inline-mobile">
        <summary>📑 Contents</summary>
        <ol class="toc-list">
          <% toc.forEach(t => { %><li class="toc-l<%= t.level %>"><a href="#<%= t.id %>"><%= t.text %></a></li><% }) %>
        </ol>
      </details>
    <% } %>
    <div class="article-body"><%- post.body %></div>
    <% if (isGuide || isBlog) { %>
      <div class="cta-band">
<%# The entry point is the path: nine of them, each with its own dashboard.
    Sending a reader straight to /paths shows them that before asking for an
    email. %>
        <p><strong>Keep the paperwork and the business in one place.</strong> NoBossly is a free workspace and community for people building a business around a job. Pick one of nine paths and your dashboard is set up for it: a plumber tracks jobs and repeat customers, a podcaster tracks downloads and sponsors.</p>
        <a class="btn btn-primary" style="margin-top:1rem;display:inline-block" href="<%= user ? '/dashboard' : '/paths' %>"><%= user ? 'Back to your dashboard →' : 'Find your path — free →' %></a>
      </div>
    <% } %>
  </article>
  <% if (sidebar) { %>
    <aside class="post-sidebar">
      <% if (hasToc) { %>
        <details class="toc toc-accordion">
          <summary>📑 Contents</summary>
          <ol class="toc-list">
            <% toc.forEach(t => { %><li class="toc-l<%= t.level %>"><a href="#<%= t.id %>"><%= t.text %></a></li><% }) %>
          </ol>
        </details>
      <% } %>
      <% if (sidebar.config.html_top) { %><div class="sidebar-html"><%- sidebar.config.html_top %></div><% } %>
      <% if (sidebar.config.show_similar && sidebar.similar.length) { %>
        <div class="card">
          <h3>Keep reading</h3>
          <% sidebar.similar.forEach(s => { %>
            <a class="similar-post" href="<%= sidebar.base + s.slug %>">
              <% if (s.featured_image) { %><img src="<%= s.featured_image %>" alt="" loading="lazy"><% } %>
              <span><%= s.title %></span>
            </a>
          <% }) %>
        </div>
      <% } %>
      <% if (sidebar.config.html_middle) { %><div class="sidebar-html"><%- sidebar.config.html_middle %></div><% } %>
      <% if (sidebar.config.html_bottom) { %><div class="sidebar-html"><%- sidebar.config.html_bottom %></div><% } %>
    </aside>
  <% } %>
</div>
