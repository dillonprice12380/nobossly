<%
  var _p = (typeof currentPath !== 'undefined' && currentPath) ? currentPath : '/';
  // Home, then three groups: what you do, where the people are, and your tools.
  var APP_NAV = [
    { href: '/dashboard',      label: 'Home',        short: 'Home',     icon: 'i-suitcase',  group: '',      match: ['/dashboard'] },
    { href: '/tasks',          label: 'Tasks',       short: 'Tasks',    icon: 'i-task',      group: 'Do',    match: ['/tasks'] },
    { href: '/quests',         label: 'Quests',      short: 'Quests',   icon: 'i-challenge', group: 'Do',    match: ['/quests', '/challenges'] },
    { href: '/feed',           label: 'Feed',        short: 'Feed',     icon: 'i-team',      group: 'Grow',  match: ['/feed'] },
    { href: '/community',      label: 'Community',   short: 'Forum',    icon: 'i-community', group: 'Grow',  match: ['/community'] },
    { href: '/wins',           label: 'Wins wall',   short: 'Wins',     icon: 'i-trophy',    group: 'Grow',  match: ['/wins'] },
    { href: '/reviews',        label: 'Peer review', short: 'Reviews',  icon: 'i-collab',    group: 'Grow',  match: ['/reviews'] },
    { href: '/budget',         label: 'Money',       short: 'Money',    icon: 'i-market',    group: 'Tools', match: ['/budget'] },
    { href: '/tools',          label: 'Toolkit',     short: 'Toolkit',  icon: 'i-upgrade',   group: 'Tools', match: ['/tools'] },
    { href: '/trophies',       label: 'Trophies',    short: 'Trophies', icon: 'i-milestone', group: 'Tools', match: ['/trophies', '/milestones'] }
  ];
  var GROUPS = [
    { name: 'Do',    icon: 'i-task' },
    { name: 'Grow',  icon: 'i-community' },
    { name: 'Tools', icon: 'i-market' }
  ];
  var _active = function (item) {
    for (var i = 0; i < item.match.length; i++) {
      var m = item.match[i];
      if (_p === m || _p.indexOf(m + '/') === 0) return true;
    }
    return false;
  };
  var _inApp = APP_NAV.some(_active);
  var _home = APP_NAV[0];
  var _inGroup = function (g) { return APP_NAV.filter(function (i) { return i.group === g; }); };
%>
<% if (_inApp) { %>
<nav class="appnav" aria-label="Dashboard sections">
  <div class="appnav-tabs">
    <a class="appnav-tab <%= _active(_home) ? 'is-active' : '' %>" href="<%= _home.href %>" aria-label="<%= _home.label %>"<%= _active(_home) ? ' aria-current="page"' : '' %>>
      <svg class="appnav-ico" aria-hidden="true"><use href="#<%= _home.icon %>"/></svg><span class="appnav-long"><%= _home.label %></span>
    </a>
    <% GROUPS.forEach(function (g) { %>
      <span class="appnav-group" role="group" aria-label="<%= g.name %>">
        <span class="appnav-group-name" aria-hidden="true"><%= g.name %></span>
        <% _inGroup(g.name).forEach(function (item) { %>
          <a class="appnav-tab <%= _active(item) ? 'is-active' : '' %><%= item.short !== item.label ? ' has-short' : '' %>" href="<%= item.href %>" aria-label="<%= item.label %>"<%= _active(item) ? ' aria-current="page"' : '' %>>
            <svg class="appnav-ico" aria-hidden="true"><use href="#<%= item.icon %>"/></svg><span class="appnav-long"><%= item.label %></span><% if (item.short !== item.label) { %><span class="appnav-short"><%= item.short %></span><% } %>
          </a>
        <% }) %>
      </span>
    <% }) %>
  </div>
</nav>

<%# Phones: Home plus one button per group; each group opens its own sheet. %>
<nav class="appbar" aria-label="Dashboard sections">
  <a class="appbar-item <%= _active(_home) ? 'is-active' : '' %>" href="<%= _home.href %>"<%= _active(_home) ? ' aria-current="page"' : '' %>>
    <svg class="appbar-ico"><use href="#<%= _home.icon %>"/></svg><span><%= _home.short %></span>
  </a>
  <% GROUPS.forEach(function (g, gi) { var items = _inGroup(g.name); var on = items.some(_active); %>
    <details class="appbar-more <%= on ? 'is-active' : '' %>">
      <summary class="appbar-item" aria-label="<%= g.name %> sections">
        <svg class="appbar-ico"><use href="#<%= on ? items.filter(_active)[0].icon : g.icon %>"/></svg>
        <span><%= g.name %></span>
      </summary>
      <div class="appbar-sheet<%= gi === 0 ? ' sheet-left' : '' %>">
        <% items.forEach(function (item) { %>
          <a class="<%= _active(item) ? 'is-active' : '' %>" href="<%= item.href %>">
            <svg class="appbar-ico"><use href="#<%= item.icon %>"/></svg><span><%= item.label %></span>
          </a>
        <% }) %>
      </div>
    </details>
  <% }) %>
</nav>

<style>
  .appnav { background: var(--panel-2); border-bottom: 1px solid var(--border); }
  /* Every tab stays visible: the row wraps instead of scrolling out of sight. */
  .appnav-tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 0 .15rem;
    max-width: 1280px; margin: 0 auto; padding: 0 .5rem; }
  .appnav-tab { display: inline-flex; align-items: center; gap: .45rem; flex: none;
    padding: .8rem .85rem; color: var(--muted); text-decoration: none; font-size: .93rem;
    border-bottom: 2px solid transparent; white-space: nowrap; }
  .appnav-short { display: none; }
  /* Medium widths: shorter labels and tighter spacing, so most windows fit one row. */
  @media (max-width: 1260px) {
    .appnav-tab { padding: .75rem .6rem; gap: .35rem; font-size: .9rem; }
    .appnav-tab.has-short .appnav-long { display: none; }
    .appnav-tab.has-short .appnav-short { display: inline; }
  }
  @media (max-width: 920px) {
    .appnav-tab { padding: .75rem .42rem; gap: .3rem; font-size: .86rem; }
  }
  .appnav-tab:hover { color: var(--text); }
  .appnav-tab.is-active { color: var(--accent); border-bottom-color: var(--accent); font-weight: 600; }
  .appnav-ico { width: 18px; height: 18px; fill: currentColor; flex: none; }
  .appnav-group { display: inline-flex; align-items: center; flex-wrap: wrap; border-left: 1px solid var(--border); margin-left: .35rem; padding-left: .45rem; }
  .appnav-group-name { font-size: .68rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin-right: .1rem; opacity: .8; }

  .appbar { display: none; }
  @media (max-width: 820px) {
    .appnav { display: none; }
    .appbar {
      display: flex; position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
      background: var(--panel-2); border-top: 1px solid var(--border);
      padding-bottom: env(safe-area-inset-bottom);
      box-shadow: 0 -2px 12px rgba(0,0,0,.06);
    }
    .appbar-item {
      flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; align-items: center;
      justify-content: center; gap: .15rem; padding: .5rem .2rem .55rem;
      color: var(--muted); text-decoration: none; font-size: .68rem; line-height: 1.1;
      background: none; border: 0; cursor: pointer; list-style: none;
    }
    .appbar-item::-webkit-details-marker { display: none; }
    .appbar-item span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%; }
    .appbar-item.is-active, .appbar-more.is-active > .appbar-item { color: var(--accent); font-weight: 600; }
    .appbar-ico { width: 21px; height: 21px; fill: currentColor; }
    .appbar-more { flex: 1 1 0; min-width: 0; position: relative; }
    .appbar-more > summary { width: 100%; }
    .appbar-sheet {
      position: absolute; right: .25rem; bottom: 100%; margin-bottom: .45rem;
      background: var(--panel-2); border: 1px solid var(--border); border-radius: 14px;
      box-shadow: 0 8px 28px rgba(0,0,0,.18); padding: .35rem; min-width: 11rem;
    }
    .appbar-sheet.sheet-left { right: auto; left: .25rem; }
    .appbar-sheet a {
      display: flex; align-items: center; gap: .6rem; padding: .7rem .8rem;
      color: var(--text); text-decoration: none; border-radius: 10px; font-size: .95rem;
    }
    .appbar-sheet a.is-active { color: var(--accent); font-weight: 600; background: rgba(16,185,129,.1); }
    body { padding-bottom: calc(4.2rem + env(safe-area-inset-bottom)); }
  }
</style>
<% } %>
