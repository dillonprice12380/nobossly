<%
  var _p = (typeof currentPath !== 'undefined' && currentPath) ? currentPath : '/';
  var _f = (typeof flags !== 'undefined' && flags) ? flags : {};
  // Five sections, like any social site: the timeline, the open community,
  // groups, challenges, and the member's own dashboard (their workspace).
  // Each section's pages sit in a second row so everything is one click away.
  var APP_NAV = [
    { href: '/feed',       label: 'Feed',       short: 'Feed',       icon: 'i-team',      match: ['/feed'], subs: [] },
    { href: '/community',  label: 'Community',  short: 'Community',  icon: 'i-community', match: ['/community', '/exchange', '/members', '/reviews', '/collaborations'],
      subs: [
        { href: '/community', label: 'Q&A', match: ['/community'], not: ['/community/collab'] },
        { href: '/exchange', label: 'Help & exchange', match: ['/exchange'], flag: 'helpBoard' },
        { href: '/members', label: 'Members', match: ['/members'] },
        { href: '/reviews', label: 'Get feedback', match: ['/reviews'] },
        { href: '/community/collab', label: 'Collaborators', match: ['/community/collab', '/collaborations'], flag: 'collabs' }
      ] },
    { href: '/groups',     label: 'Groups',     short: 'Groups',     icon: 'i-collab',    match: ['/groups'], subs: [] },
    { href: '/quests',     label: 'Challenges', short: 'Challenges', icon: 'i-challenge', match: ['/quests', '/challenges', '/wins'],
      subs: [
        { href: '/quests', label: 'Challenges & cohorts', match: ['/quests', '/challenges'] },
        { href: '/wins', label: 'Results', match: ['/wins'], flag: 'wins' }
      ] },
    { href: '/dashboard',  label: 'Dashboard',  short: 'Dashboard',  icon: 'i-suitcase',  match: ['/dashboard', '/workspace', '/surveys', '/tasks', '/budget', '/tools', '/trophies', '/milestones'],
      subs: [
        { href: '/dashboard', label: 'Overview', match: ['/dashboard'] },
        { href: '/workspace', label: 'Workspace', match: ['/workspace'] },
        { href: '/surveys', label: 'Surveys', match: ['/surveys'] },
        { href: '/tasks', label: 'Tasks', match: ['/tasks'] },
        { href: '/budget', label: 'Money', match: ['/budget'] },
        { href: '/tools', label: 'Tools', match: ['/tools'] },
        { href: '/trophies', label: 'Trophies', match: ['/trophies', '/milestones'], flag: 'trophies' }
      ] }
  ];
  var _hit = function (m) { return _p === m || _p.indexOf(m + '/') === 0; };
  var _active = function (item) {
    if ((item.not || []).some(_hit)) return false;
    return item.match.some(_hit);
  };
  var _shown = function (sub) { return !sub.flag || _f[sub.flag]; };
  var _inApp = APP_NAV.some(_active);
  var _section = APP_NAV.filter(_active)[0];
  var _subs = _section ? _section.subs.filter(_shown) : [];
%>
<% if (_inApp) { %>
<nav class="appnav" aria-label="Sections">
  <div class="appnav-tabs">
    <% APP_NAV.forEach(function (item) { %>
      <a class="appnav-tab <%= _active(item) ? 'is-active' : '' %>" href="<%= item.href %>"<%= _active(item) ? ' aria-current="page"' : '' %>>
        <svg class="appnav-ico" aria-hidden="true"><use href="#<%= item.icon %>"/></svg><span><%= item.label %></span>
      </a>
    <% }) %>
  </div>
  <% if (_subs.length > 1) { %>
    <div class="appnav-subs" aria-label="<%= _section.label %> pages">
      <% _subs.forEach(function (sub) { %>
        <a class="appnav-sub <%= _active(sub) ? 'is-active' : '' %>" href="<%= sub.href %>"<%= _active(sub) ? ' aria-current="page"' : '' %>><%= sub.label %></a>
      <% }) %>
    </div>
  <% } %>
</nav>

<%# Phones: the same five sections along the bottom; a section's pages show as
    the row of links at the top of the page. %>
<nav class="appbar" aria-label="Sections">
  <% APP_NAV.forEach(function (item) { %>
    <a class="appbar-item <%= _active(item) ? 'is-active' : '' %>" href="<%= item.href %>"<%= _active(item) ? ' aria-current="page"' : '' %>>
      <svg class="appbar-ico"><use href="#<%= item.icon %>"/></svg><span><%= item.short %></span>
    </a>
  <% }) %>
</nav>

<style>
  .appnav { background: var(--panel-2); border-bottom: 1px solid var(--border); }
  /* Every tab stays visible: the row wraps instead of scrolling out of sight. */
  .appnav-tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 0 .15rem;
    max-width: 1280px; margin: 0 auto; padding: 0 .5rem; }
  .appnav-tab { display: inline-flex; align-items: center; gap: .45rem; flex: none;
    padding: .8rem .85rem; color: var(--muted); text-decoration: none; font-size: .93rem;
    border-bottom: 2px solid transparent; white-space: nowrap; }
  @media (max-width: 920px) {
    .appnav-tab { padding: .75rem .42rem; gap: .3rem; font-size: .86rem; }
  }
  .appnav-tab:hover { color: var(--text); }
  .appnav-tab.is-active { color: var(--accent); border-bottom-color: var(--accent); font-weight: 600; }
  .appnav-ico { width: 18px; height: 18px; fill: currentColor; flex: none; }
  .appnav-subs { display: flex; flex-wrap: wrap; justify-content: center; gap: .3rem; padding: .45rem .5rem .55rem; border-top: 1px solid var(--border); }
  .appnav-sub { padding: .3rem .7rem; border-radius: 999px; color: var(--muted); text-decoration: none; font-size: .88rem; border: 1px solid transparent; }
  .appnav-sub:hover { color: var(--text); }
  .appnav-sub.is-active { color: var(--accent); border-color: var(--accent); font-weight: 600; }

  .appbar { display: none; }
  @media (max-width: 820px) {
    /* The five sections move to the bottom bar; the section's own pages stay on top. */
    .appnav-tabs { display: none; }
    .appnav-subs { border-top: 0; }
    .appbar {
      display: flex; position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
      background: var(--panel-2); border-top: 1px solid var(--border);
      padding-bottom: env(safe-area-inset-bottom);
      box-shadow: 0 -2px 12px rgba(0,0,0,.06);
    }
    .appbar-item {
      flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; align-items: center;
      justify-content: center; gap: .15rem; padding: .5rem .2rem .55rem;
      color: var(--muted); text-decoration: none; font-size: .68rem; line-height: 1.1;
      background: none; border: 0; cursor: pointer; list-style: none;
    }
    .appbar-item span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%; }
    .appbar-item.is-active { color: var(--accent); font-weight: 600; }
    .appbar-ico { width: 21px; height: 21px; fill: currentColor; }
    body { padding-bottom: calc(4.2rem + env(safe-area-inset-bottom)); }
  }
</style>
<% } %>
