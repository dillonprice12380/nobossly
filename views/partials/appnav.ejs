<%
  var _p = (typeof currentPath !== 'undefined' && currentPath) ? currentPath : '/';
  var _f = (typeof flags !== 'undefined' && flags) ? flags : {};
  // Five sections, like any social site: the timeline, the open community,
  // groups, challenges, and the member's own dashboard (their workspace).
  // Each section's pages sit in a second row so everything is one click away.
  // Three sections, the same three as the header: the member's own Dashboard,
  // the Community, and Resources. Each section's pages sit in the row below
  // the header, so everything is one click away. A page can name its section
  // page with res.locals.navSub (a worksheet about money lives under
  // /workspace but belongs to Money).
  var APP_NAV = [
    { key: 'dashboard', href: '/dashboard', label: 'Dashboard', short: 'Dashboard', icon: 'i-suitcase',
      match: ['/dashboard', '/workspace', '/surveys', '/tasks', '/budget', '/tools', '/trophies', '/milestones'],
      subs: [
        { key: 'overview', href: '/dashboard', label: 'Overview', match: ['/dashboard'] },
        { key: 'workspace', href: '/workspace', label: 'Workspace', match: ['/workspace', '/surveys', '/tasks', '/tools'], not: ['/tools/pricing', '/tools/tax'] },
        { key: 'money', href: '/budget', label: 'Money', match: ['/budget', '/tools/pricing', '/tools/tax'] },
        { key: 'trophies', href: '/trophies', label: 'Trophies', match: ['/trophies', '/milestones'], flag: 'trophies' }
      ] },
    { key: 'community', href: '/community', label: 'Community', short: 'Community', icon: 'i-community',
      match: ['/community', '/feed', '/groups', '/programs', '/learn', '/quests', '/challenges', '/wins', '/exchange', '/members', '/reviews', '/collaborations'],
      subs: [
        { key: 'feed', href: '/feed', label: 'Feed', match: ['/feed'] },
        { key: 'qa', href: '/community', label: 'Q&A', match: ['/community'], not: ['/community/collab'] },
        { key: 'groups', href: '/groups', label: 'Groups', match: ['/groups'] },
        { key: 'programs', href: '/programs', label: 'Programs & courses', match: ['/programs', '/learn'], flag: 'marketplace' },
        { key: 'challenges', href: '/quests', label: 'Challenges', match: ['/quests', '/challenges'] },
        { key: 'results', href: '/wins', label: 'Results', match: ['/wins'], flag: 'wins' },
        { key: 'exchange', href: '/exchange', label: 'Help & exchange', match: ['/exchange'], flag: 'helpBoard' },
        { key: 'members', href: '/members', label: 'Members', match: ['/members'] },
        { key: 'reviews', href: '/reviews', label: 'Get feedback', match: ['/reviews'] },
        { key: 'collab', href: '/community/collab', label: 'Collaborators', match: ['/community/collab', '/collaborations'], flag: 'collabs' }
      ] },
    { key: 'resources', href: '/blog', label: 'Resources', short: 'Resources', icon: 'i-blog',
      match: ['/blog', '/guides', '/locations', '/help'],
      subs: [
        { key: 'blog', href: '/blog', label: 'Blog', match: ['/blog'] },
        { key: 'guides', href: '/guides', label: 'Guides', match: ['/guides'] },
        { key: 'locations', href: '/locations', label: 'Locations', match: ['/locations'] },
        { key: 'help', href: '/help', label: 'Help Center', match: ['/help'] }
      ] }
  ];
  var _hit = function (m) { return _p === m || _p.indexOf(m + '/') === 0; };
  var _active = function (item) {
    if ((item.not || []).some(_hit)) return false;
    return item.match.some(_hit);
  };
  var _shown = function (sub) { return !sub.flag || _f[sub.flag]; };
  var _inApp = APP_NAV.some(_active);
  var _section = APP_NAV.filter(_active)[0];
  var _subs = _section ? _section.subs.filter(_shown) : [];
  var _forced = (typeof navSub !== 'undefined' && navSub) ? navSub : null;
  var _subOn = function (sub) { return _forced ? sub.key === _forced : _active(sub); };
%>
<% if (_inApp) { %>
<% if (_subs.length > 1) { %>
<nav class="appnav" aria-label="<%= _section.label %> pages">
  <div class="appnav-subs">
    <% _subs.forEach(function (sub) { %>
      <a class="appnav-sub <%= _subOn(sub) ? 'is-active' : '' %>" href="<%= sub.href %>"<%= _subOn(sub) ? ' aria-current="page"' : '' %>><%= sub.label %></a>
    <% }) %>
  </div>
</nav>
<% } %>

<%# Phones: the three sections along the bottom; a section's pages show as
    the row of links at the top of the page. %>
<nav class="appbar" aria-label="Sections">
  <% APP_NAV.forEach(function (item) { %>
    <a class="appbar-item <%= _active(item) ? 'is-active' : '' %>" href="<%= item.href %>"<%= _active(item) ? ' aria-current="page"' : '' %>>
      <svg class="appbar-ico"><use href="#<%= item.icon %>"/></svg><span><%= item.short %></span>
    </a>
  <% }) %>
</nav>

<style>
  .appnav { background: var(--panel-2); border-bottom: 1px solid var(--border); }
  /* Every tab stays visible: the row wraps instead of scrolling out of sight. */
  .appnav-subs { display: flex; flex-wrap: wrap; justify-content: center; gap: .3rem; padding: .5rem .5rem .55rem; max-width: 1280px; margin: 0 auto; }
  .appnav-sub { padding: .3rem .7rem; border-radius: 999px; color: var(--muted); text-decoration: none; font-size: .88rem; border: 1px solid transparent; }
  .appnav-sub:hover { color: var(--text); }
  .appnav-sub.is-active { color: var(--accent); border-color: var(--accent); font-weight: 600; }

  .appbar { display: none; }
  @media (max-width: 820px) {
    /* The three sections move to the bottom bar; the section's own pages stay on top. */
    .appbar {
      display: flex; position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
      background: var(--panel-2); border-top: 1px solid var(--border);
      padding-bottom: env(safe-area-inset-bottom);
      box-shadow: 0 -2px 12px rgba(0,0,0,.06);
    }
    .appbar-item {
      flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; align-items: center;
      justify-content: center; gap: .15rem; padding: .5rem .2rem .55rem;
      color: var(--muted); text-decoration: none; font-size: .68rem; line-height: 1.1;
      background: none; border: 0; cursor: pointer; list-style: none;
    }
    .appbar-item span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%; }
    .appbar-item.is-active { color: var(--accent); font-weight: 600; }
    .appbar-ico { width: 21px; height: 21px; fill: currentColor; }
    body { padding-bottom: calc(4.2rem + env(safe-area-inset-bottom)); }
  }
</style>
<% } %>
