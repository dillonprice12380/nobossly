<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= title %> &middot; NoBossly</title>
<meta name="description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : 'NoBossly is a free community for people building their way out of a 9 to 5 — real quests, self-directed sprints, and ten levels from first customer to handing in your notice.' %>">
<link rel="canonical" href="<%= typeof canonicalUrl !== 'undefined' && canonicalUrl ? canonicalUrl : 'https://nobossly.com' %>">
<link rel="icon" type="image/png" href="https://pub-95ede4ca0cce4b26aa322170b1a5b9f1.r2.dev/Site%20Images/N_i8pl8n.png">
<link rel="preconnect" href="https://pub-95ede4ca0cce4b26aa322170b1a5b9f1.r2.dev" crossorigin>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap">
<link rel="stylesheet" href="/css/style.css?v=15">
<link rel="stylesheet" href="/css/list.css?v=2">
<link rel="stylesheet" href="/css/motion.css?v=11">
<link rel="stylesheet" href="/css/interaction.css?v=2">
<script>document.documentElement.classList.add('js');</script>
<meta name="turbo-cache-control" content="no-preview">
<meta name="view-transition" content="same-origin">
<script src="https://cdn.jsdelivr.net/npm/@hotwired/turbo@8.0.4/dist/turbo.es2017-umd.js"></script>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-8973F7WW8N"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-8973F7WW8N');
  (function () {
    var first = true;
    document.addEventListener('turbo:load', function () {
      if (first) { first = false; return; }
      gtag('event', 'page_view', {
        page_path: location.pathname + location.search,
        page_location: location.href,
        page_title: document.title
      });
    });
  })();
</script>
</head>
<body class="<%= typeof bodyTheme !== 'undefined' ? bodyTheme : 'theme-light' %>">
<%- include('icons') %>
<nav class="nav">
  <a class="brand" href="/"><img class="logo-img" src="https://pub-95ede4ca0cce4b26aa322170b1a5b9f1.r2.dev/Site%20Images/nobossly-logo_a5ew2x.png" alt="NoBossly"></a>
  <button class="nav-toggle" id="nav-toggle" aria-label="Menu" aria-expanded="false"><svg viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18"/></svg></button>
  <div class="nav-links" id="nav-links">
    <% if (user) { %>
      <a href="/dashboard">Dashboard</a>
      <div class="nav-dropdown" data-dd>
        <button type="button" class="nav-dd-btn" aria-haspopup="true" aria-expanded="false">Resources <span class="caret">▾</span></button>
        <div class="nav-dd-menu">
          <a href="/blog"><svg class="icon"><use href="#i-blog"/></svg> Blog</a>
          <a href="/guides"><svg class="icon"><use href="#i-milestone"/></svg> Guides</a>
          <a href="/locations"><svg class="icon"><use href="#i-milestone"/></svg> Locations</a>
          <a href="/help"><svg class="icon"><use href="#i-help"/></svg> Help Center</a>
        </div>
      </div>
      <a class="bell" href="/messages" title="Messages"><svg class="nav-ico" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg><% if (typeof unreadMsgs !== 'undefined' && unreadMsgs > 0) { %><span class="nav-badge"><%= unreadMsgs > 9 ? '9+' : unreadMsgs %></span><% } %></a>
      <details class="notif-menu" id="notif-menu">
        <summary class="bell" title="Notifications" aria-haspopup="true">
          <svg class="nav-ico" viewBox="0 0 24 24"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
          <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %><span class="nav-badge"><%= unreadCount > 9 ? '9+' : unreadCount %></span><% } %>
        </summary>
        <div class="notif-panel">
          <div class="notif-head">
            <strong>Notifications</strong>
            <button type="button" class="notif-readall">Mark all read</button>
          </div>
          <div class="notif-list">
            <p class="muted small notif-msg"><a href="/notifications">Open notifications</a></p>
          </div>
          <a class="notif-all" href="/notifications">See all notifications</a>
        </div>
      </details>
      <% if (profile && profile.is_admin) { %><a href="/admin" title="Admin"><svg class="nav-ico" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></a><% } %>
      <div class="avatar-menu" id="avatar-menu">
        <button class="avatar-btn" id="avatar-btn" aria-haspopup="true" aria-expanded="false">
          <% if (profile && profile.avatar_url) { %><img src="<%= profile.avatar_url %>" alt=""><% } else { %><%= ((profile && (profile.display_name || profile.username)) || '?').slice(0,1).toUpperCase() %><% } %>
        </button>
        <div class="avatar-dropdown" id="avatar-dropdown">
          <span class="muted small" style="padding:.4rem .9rem;display:block">@<%= profile ? profile.username : '' %></span>
      <a href="/profile"><svg class="icon"><use href="#i-profile"/></svg> My profile</a>
          <a href="/tools"><svg class="icon"><use href="#i-upgrade"/></svg> Premium tools</a>
          <a href="/account"><svg class="icon"><use href="#i-setting"/></svg> Account settings</a>
          <form method="post" action="/logout"><button type="submit"><svg class="icon"><use href="#i-logout"/></svg> Log out</button></form>
        </div>
      </div>
    <% } else { %>
      <a href="/paths">Paths</a>
      <a href="/community">Community</a>
      <a href="/how-it-works">How it works</a>
      <a href="/pricing">Premium</a>
      <div class="nav-dropdown" data-dd>
        <button type="button" class="nav-dd-btn" aria-haspopup="true" aria-expanded="false">Resources <span class="caret">▾</span></button>
        <div class="nav-dd-menu">
          <a href="/blog"><svg class="icon"><use href="#i-blog"/></svg> Blog</a>
          <a href="/guides"><svg class="icon"><use href="#i-milestone"/></svg> Guides</a>
          <a href="/locations"><svg class="icon"><use href="#i-milestone"/></svg> Locations</a>
          <a href="/help"><svg class="icon"><use href="#i-help"/></svg> Help Center</a>
        </div>
      </div>
      <a href="/login">Log in</a>
      <a class="btn btn-primary" href="/paths">Find your path</a>
    <% } %>
  </div>
</nav>
<% if (user) { %>
<style>
  .notif-menu { position: relative; }
  .notif-menu > summary { list-style: none; cursor: pointer; }
  .notif-menu > summary::-webkit-details-marker { display: none; }
  .notif-panel {
    position: absolute; right: 0; top: calc(100% + .5rem); z-index: 70;
    width: min(21rem, calc(100vw - 1.5rem));
    background: var(--panel-2); color: var(--text);
    border: 1px solid var(--border); border-radius: 14px;
    box-shadow: 0 10px 34px rgba(0,0,0,.22); overflow: hidden;
  }
  .notif-head { display: flex; align-items: center; justify-content: space-between; gap: .5rem;
    padding: .7rem .85rem; border-bottom: 1px solid var(--border); }
  .notif-readall { font: inherit; font-size: .78rem; color: var(--muted); cursor: pointer;
    background: none; border: 1px solid var(--border); border-radius: 8px; padding: .25rem .5rem; width: auto; }
  .notif-readall:hover { color: var(--text); }
  .notif-list { max-height: min(60vh, 24rem); overflow-y: auto; }
  .notif-item { display: flex; flex-direction: column; gap: .15rem; padding: .7rem .85rem;
    border-bottom: 1px solid var(--border); color: var(--text); text-decoration: none; }
  .notif-item:hover { background: rgba(16,185,129,.06); color: var(--text); }
  .notif-item .notif-text { color: var(--text); }
  .notif-item.is-unread { background: rgba(16,185,129,.1); }
  .notif-text { font-size: .9rem; line-height: 1.35; overflow-wrap: anywhere; }
  .notif-msg { padding: 1.1rem .85rem; margin: 0; text-align: center; }
  .notif-all { display: block; padding: .7rem; text-align: center; font-size: .9rem;
    color: var(--accent); text-decoration: none; font-weight: 600; }
  @media (max-width: 820px) {
    .notif-panel { position: static; width: 100%; box-shadow: none; margin: .4rem 0; }
  }
</style>
<%- include('appnav') %>
<% } %>
<% if (typeof pendingDeletion !== 'undefined' && pendingDeletion) { %>
<div class="warn-banner">⚠️ Your account is scheduled for permanent deletion on <%= new Date(new Date(pendingDeletion).getTime() + 7*86400000).toLocaleDateString() %>. <form method="post" action="/account/cancel-deletion" class="inline"><button class="btn btn-sm btn-primary">Cancel deletion</button></form></div>
<% } %>
<main class="container">
