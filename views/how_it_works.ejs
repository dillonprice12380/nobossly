  <h2 style="text-align:center;margin-bottom:.5rem">Start free. Go deeper when you're ready.</h2>
  <p class="muted" style="text-align:center;margin-bottom:2rem">No credit card needed to start. Upgrade any time from your account settings.</p>
  <div class="pricing-grid">
    <div class="card price-card">
      <h3>Free</h3>
      <p class="price">$0<span class="muted small"> forever</span></p>
      <ul class="feature-list">
        <li>&#10003; 1 AI idea generation</li>
        <li>&#10003; Community forum access</li>
        <li>&#10003; Up to 8 tasks at a time</li>
        <li>&#10003; Member profile &amp; XP levels</li>
      </ul>
      <a class="btn btn-ghost btn-block" href="/signup">Get started free</a>
    </div>
    <div class="card price-card price-featured">
      <span class="chip chip-success">Full access</span>
      <h3>Paid plans</h3>
      <p class="price">From <span style="font-weight:700">$12</span><span class="muted small">/month</span></p>
      <ul class="feature-list">
        <li>&#10003; Everything in Free</li>
        <li>&#10003; Unlimited AI idea generations</li>
        <li>&#10003; AI launch blueprints</li>
        <li>&#10003; AI roadmap &amp; automatic task dispersement</li>
        <li>&#10003; Challenges &amp; milestones</li>
        <li>&#10003; Collaborations &amp; teams</li>
        <li>&#10003; Budget tracker</li>
        <li>&#10003; Priority support</li>
      </ul>
      <a class="btn btn-primary btn-block" href="/pricing">See all plans</a>
    </div>
  </div>
</section>

<!-- ───── CTA ───── -->
<section class="cta-band reveal reveal-up">
  <h2>Your boss isn&rsquo;t going to fire themselves.</h2>
  <p class="muted">Join NoBossly free and get your first AI-matched business ideas in under 10 minutes.</p>
  <a class="btn btn-primary btn-lg" style="margin-top:1.1rem;display:inline-block" href="/signup">Get my business ideas &rarr;</a>
</section>

