<%- include('partials/head') %>
<%
  var d = (compass && compass.data) || {};
  var arch = d.archetype || {};
  var lo = d.loadout || {};
  var terrs = Array.isArray(d.territories) ? d.territories : [];
  var fit = Array.isArray(d.fit_test) ? d.fit_test : [];
  var avoid = Array.isArray(d.avoid_list) ? d.avoid_list : [];
  var kit = Array.isArray(d.toolkit) ? d.toolkit : [];
  var tempChip = function (t) {
    if (t === 'hot') return '🔥 hot';
    if (t === 'warm') return '🌤️ warm';
    return '🌱 steady';
  };
%>
<div class="page-head">
  <div><h1>🧭 Your Compass</h1>
  <p class="muted">Your map, your call — the Compass sharpens your judgement, you choose the direction.</p></div>
  <a class="btn btn-ghost" href="/compass/generate">Redraw Compass</a>
</div>
<% if (msg) { %><p class="notice"><%= msg %></p><% } %>

<%# Onboarding asks seven questions. The rest of the questionnaire is offered
    here instead, where you can see what a sharper Compass would sharpen. %>
<% if (typeof canDeepen !== 'undefined' && canDeepen) { %>
  <div class="card" style="display:flex;gap:1rem;align-items:center;flex-wrap:wrap;justify-content:space-between">
    <div style="flex:1;min-width:16rem">
      <h2 style="margin:0 0 .2rem">Want a sharper Compass?</h2>
      <p class="muted small" style="margin:0">This one was drawn from seven answers. Five more short rounds — your constraints, your work style, what you'd regret — and it gets redrawn against the fuller picture. Stop whenever you like; you keep what you have.</p>
    </div>
    <a class="btn btn-primary" style="flex:none" href="/questionnaire?step=3">Sharpen it →</a>
  </div>
<% } %>

<div class="card" style="text-align:center">
  <div style="font-size:2.6rem;line-height:1"><%= arch.emoji || '🧭' %></div>
  <h2 style="margin:.35rem 0 .15rem"><%= arch.name || 'Your archetype' %></h2>
  <p style="margin:.2rem 0"><strong><%= arch.tagline || '' %></strong></p>
  <p class="muted" style="max-width:44rem;margin:.4rem auto 0"><%= arch.description || '' %></p>
</div>

<div class="card">
  <h2>🎒 Your loadout</h2>
  <div class="grid">
    <div><h3 class="small">Strengths</h3><% (lo.strengths || []).forEach(function (x) { %><span class="chip" style="margin:.15rem .2rem .15rem 0;display:inline-block"><%= x %></span><% }) %></div>
    <div><h3 class="small">Unfair advantages</h3><% (lo.advantages || []).forEach(function (x) { %><span class="chip chip-success" style="margin:.15rem .2rem .15rem 0;display:inline-block"><%= x %></span><% }) %></div>
    <div><h3 class="small">Binding constraints</h3><% (lo.constraints || []).forEach(function (x) { %><p class="muted small" style="margin:.2rem 0">⛓️ <%= x %></p><% }) %></div>
  </div>
  <% if ((lo.honest_notes || []).length) { %>
    <div style="border-top:1px solid var(--border);margin-top:.8rem;padding-top:.7rem">
      <h3 class="small">Straight talk</h3>
      <% lo.honest_notes.forEach(function (x) { %><p class="small" style="margin:.25rem 0">💬 <%= x %></p><% }) %>
    </div>
  <% } %>
</div>

<h2 style="margin:1.1rem 0 .5rem">🗺️ Territories worth exploring</h2>
<div class="grid">
  <% terrs.forEach(function (t) { %>
    <div class="card">
      <div class="page-head" style="margin-bottom:.3rem"><h3 style="margin:0"><%= t.name || '' %></h3><span class="chip"><%= tempChip(t.temperature) %></span></div>
      <p class="small"><%= t.why_you || '' %></p>
      <% if ((t.example_plays || []).length) { %><p class="muted small" style="margin:.35rem 0 0"><strong>Example plays:</strong> <%= (t.example_plays || []).join(' · ') %></p><% } %>
      <% if (t.watch_out) { %><p class="muted small" style="margin:.35rem 0 0">⚠️ <%= t.watch_out %></p><% } %>
    </div>
  <% }) %>
</div>

<div class="grid" style="margin-top:1rem">
  <div class="card">
    <h2>✅ Your 5-point fit test</h2>
    <p class="muted small">Any idea you choose — yours or anyone's — should pass these. They came from your own answers.</p>
    <ol style="padding-left:1.2rem;margin:.5rem 0 0">
      <% fit.forEach(function (f) { %><li style="margin:.4rem 0"><strong><%= f.criterion || '' %></strong><br><span class="muted small"><%= f.why || '' %></span></li><% }) %>
    </ol>
  </div>
  <div class="card">
    <h2>🚫 Tempting, but not for you</h2>
    <% avoid.forEach(function (a) { %>
      <p style="margin:.45rem 0"><strong><%= a.territory || '' %></strong><br><span class="muted small"><%= a.reason || '' %></span></p>
    <% }) %>
    <% if (kit.length) { %>
      <div style="border-top:1px solid var(--border);margin-top:.7rem;padding-top:.6rem">
        <h3 class="small">🧰 Starter toolkit</h3>
        <% kit.forEach(function (k) { %><p class="small" style="margin:.25rem 0"><strong><%= k.name || '' %></strong> — <%= k.purpose || '' %> <span class="chip" style="font-size:.7rem"><%= k.cost || '' %></span></p><% }) %>
      </div>
    <% } %>
  </div>
</div>

<div class="card" style="margin-top:1rem">
  <h2>✍️ Draft YOUR idea</h2>
  <p class="muted small">You choose the direction — in your own words. Your advisor stress-tests it against your own 5-point fit test and the live market, then scores it: pass or fail on each criterion, with the reason. Revise, re-run, watch the score move. Getting to 5/5 is Level 1. Takes about a minute per pass.</p>
  <form method="post" action="/compass/draft" data-turbo="false" onsubmit="var b=this.querySelector('button[type=submit]');b.disabled=true;b.textContent='Your advisor is thinking… (about a minute)';">
    <label class="small">Idea name *<input name="name" maxlength="140" required placeholder="e.g. Route-Ready Bookkeeping"></label>
    <label class="small">One-liner<input name="tagline" maxlength="200" placeholder="What it does, in one sentence"></label>
    <label class="small">Describe it<textarea name="description" rows="3" maxlength="2000" placeholder="What you'd offer, and roughly how"></textarea></label>
    <label class="small">Problem it solves<input name="problem" maxlength="1000"></label>
    <label class="small">First customer you'd target<input name="customer" maxlength="500"></label>
    <label class="small">How it makes money<input name="monetization" maxlength="500"></label>
    <div class="cta-row"><button type="submit" class="btn btn-primary">Run it past your advisor</button>
    <a class="btn btn-ghost" href="/ideas">See my ideas</a></div>
  </form>
</div>
<%- include('partials/foot') %>
