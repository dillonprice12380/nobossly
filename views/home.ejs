<%- include('partials/head') %>
<%# The home page for signed-out visitors (server.js GET /). Three parts:
    Workspace, Money, Community. The pictures are the real pages with sample
    data (scripts/home_shots.js makes them). The "what are you building?"
    picker works without JavaScript (radio buttons), and its button carries
    the choice through sign-up (/signup?path=…). %>
<% var P = (typeof paths !== 'undefined' && paths) ? paths : [];
   var prev = (typeof previews !== 'undefined' && previews) ? previews : {};
   var first = P.some(function (p) { return p.slug === 'freelancer'; }) ? 'freelancer' : (P[0] && P[0].slug);
   var faqs = (typeof faq !== 'undefined' && faq) ? faq : []; %>

<section class="hm-hero">
  <div class="hm-hero-text">
    <h1>Build your way out<br>of the <span class="accent-text">9 to 5.</span></h1>
    <p class="lead">A free workspace and community for people building a business around a job. Your numbers, your money and other people doing the same thing, in one place that fits your evenings.</p>
    <p class="muted small hm-free">Free. No card. Works on your phone.</p>
  </div>

  <% if (P.length) { %>
  <div class="card hm-pick" aria-labelledby="hm-pick-h">
    <h2 id="hm-pick-h">What are you building?</h2>
    <% P.forEach(function (p) { %><input type="radio" name="hm-path" id="hp-<%= p.slug %>" class="hm-radio" <%= p.slug === first ? 'checked' : '' %>><% }) %>
    <div class="hm-chips" role="presentation">
      <% P.forEach(function (p) { %><label for="hp-<%= p.slug %>" class="hm-chip"><span><%= p.emoji %></span> <%= p.label %></label><% }) %>
    </div>
    <div class="hm-panels">
      <% P.forEach(function (p) { var v = prev[p.slug]; %>
        <div class="hm-panel hm-panel-<%= p.slug %>">
          <p class="hm-panel-h"><%= p.emoji %> Your <%= p.label.toLowerCase() %> dashboard</p>
          <% if (v) { %>
            <% if (v.numbers.length) { %><p class="small hm-row"><span class="muted">Numbers:</span> <%= v.numbers.slice(0, 4).join(' · ') %></p><% } %>
            <% if (v.boards.length) { %><p class="small hm-row"><span class="muted">Boards:</span> <%= v.boards.map(function (b) { return b.label; }).join(' · ') %></p><% } %>
            <% if (v.tools.length) { %><p class="small hm-row"><span class="muted">Tools:</span> <%= v.tools.map(function (t) { return t.label; }).join(' · ') %></p><% } %>
          <% } %>
          <div class="cta-row hm-panel-cta">
            <a class="btn btn-primary" href="/signup?path=<%= p.slug %>"><%= wordsFor(p).cta %> →</a>
            <a class="muted small" href="/paths/<%= p.slug %>">See the whole dashboard</a>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
  <% } else { %>
    <div class="cta-row"><a class="btn btn-primary btn-lg" href="/signup">Join free →</a></div>
  <% } %>
</section>

<nav class="hm-pillars" aria-label="What's inside">
  <a href="#workspace"><strong>🧰 Workspace</strong><span class="muted small">A dashboard, boards, notes and worksheets for your kind of business</span></a>
  <a href="#money"><strong>💰 Money</strong><span class="muted small">What came in, what went out, and what to keep aside for tax</span></a>
  <a href="#community"><strong>🤝 Community</strong><span class="muted small">Q&amp;A, co-working and people doing the same thing</span></a>
</nav>

<section class="hm-feature reveal reveal-up" id="workspace">
  <div class="hm-copy">
    <p class="hm-kicker">Workspace</p>
    <h2>A dashboard for what you're actually building</h2>
    <p class="muted">A YouTuber and a café owner don't need the same dashboard. Pick your path and yours has the numbers, boards and tools for that kind of business.</p>
    <ul class="feature-list">
      <li><strong>Your numbers</strong> with the trend at a glance: income, clients, followers, sign-ups</li>
      <li><strong>Boards</strong> for the work in progress: clients, jobs, content, orders</li>
      <li><strong>Coming up this week</strong>: due dates, renewals and challenge ends in one list</li>
      <li><strong>Notes and worksheets</strong>: Lean Canvas, personas, pitches, proposals, with one search across all of it</li>
      <li><strong>Your layout</strong>: pin what you use, hide what you don't</li>
    </ul>
  </div>
  <figure class="hm-shot"><img src="/img/home/dashboard.jpg" width="1560" height="1080" alt="A freelancer's NoBossly dashboard: money this month, what's coming up this week, billable income and a client pipeline" loading="lazy" decoding="async"></figure>
</section>

<section class="hm-feature flip reveal reveal-up" id="money">
  <div class="hm-copy">
    <p class="hm-kicker">Money</p>
    <h2>Know what you made, and what to keep aside</h2>
    <p class="muted">This month's income, costs and profit up top, and twelve months of it underneath.</p>
    <ul class="feature-list">
      <li><strong>Payments log themselves</strong>: connect Stripe or Shopify read-only, or import a CSV from your bank, PayPal or Etsy</li>
      <li><strong>Tax to put aside</strong> on every payment, worked out from your own rates</li>
      <li><strong>Monthly costs</strong> like software and rent log themselves too</li>
      <li><strong>Export for tax time</strong>: the year as a spreadsheet, by month and category</li>
      <li><strong>Pricing &amp; margin</strong>, break-even and cost worksheets for your path</li>
    </ul>
  </div>
  <figure class="hm-shot"><img src="/img/home/money.jpg" width="1560" height="627" alt="The NoBossly Money page: money in, money out, profit and tax to put aside, with a twelve-month chart of income against expenses" loading="lazy" decoding="async"></figure>
</section>

<section class="hm-feature reveal reveal-up" id="community">
  <div class="hm-copy">
    <p class="hm-kicker">Community</p>
    <h2>People building the same way</h2>
    <p class="muted">Everyone here is fitting a business around something else. Nobody is selling you a course.</p>
    <ul class="feature-list">
      <li><strong>Q&amp;A</strong>: ask, answer, and mark the reply that helped</li>
      <li><strong>Co-working</strong>: book an hour to work alongside other members, cameras optional</li>
      <li><strong>Groups and weekly challenges</strong> around a niche or a goal</li>
      <li><strong>Profiles with your business on them</strong>: what you offer, your links, how you've helped</li>
      <li><strong>Help &amp; exchange</strong>: trade what you're good at for what you need</li>
    </ul>
  </div>
  <figure class="hm-shot"><img src="/img/home/community.jpg" width="1560" height="1038" alt="The NoBossly community home: questions waiting for an answer, the feed, co-working sessions and members on your path" loading="lazy" decoding="async"></figure>
</section>

<section class="hm-more reveal reveal-up">
  <div class="card">
    <p class="hm-kicker">For programs</p>
    <h3>Bring your accelerator or course</h3>
    <p class="muted small">NoBossly doesn't teach; programs do. Accelerators and teachers run invite-only cohorts here with assignments, feedback and a weekly check-in, and participants do the work in the same workspace. Nothing in a cohort is visible outside it.</p>
  </div>
  <div class="card">
    <p class="hm-kicker">Reference</p>
    <h3>The paperwork, explained</h3>
    <p class="muted small">Over a hundred free pages on registering a business where you live, EINs, licences, sales tax, contracts, and tax while you're still employed. <a href="/guides">Browse</a> · <a href="/locations">By location</a></p>
  </div>
  <div class="card">
    <p class="hm-kicker">Built for spare hours</p>
    <h3>Open it, pick up where you left off</h3>
    <p class="muted small">You have a job, a commute and a few evenings a week. Everything opens where you left it and works on your phone, so a spare hour goes on the business, not on finding things.</p>
  </div>
</section>

<% if (faqs.length) { %>
<section class="hm-faq reveal reveal-up" id="faq">
  <h2>Questions</h2>
  <% faqs.forEach(function (f) { %>
    <details class="card"><summary><strong><%= f.q %></strong></summary><p class="muted"><%= f.a %></p></details>
  <% }) %>
</section>
<% } %>

<section class="cta-band reveal reveal-up">
  <h2>Keep the job. Build the way out.</h2>
  <p class="muted">Free, no card. Pick your path and your workspace is ready in about a minute.</p>
  <a class="btn btn-primary btn-lg" style="margin-top:1.1rem;display:inline-block" href="/signup">Join free →</a>
</section>

<% if (typeof structuredData !== 'undefined' && structuredData) { %>
<script type="application/ld+json"><%- JSON.stringify(structuredData).replace(/</g, '\\u003c') %></script>
<% } %>
<style>
  .hm-hero { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 2rem; align-items: center; padding: 2.5rem 0 1.5rem; }
  .hm-hero .lead { margin-left: 0; }
  .hm-free { margin: .6rem 0 0; }
  .hm-pick h2 { margin: 0 0 .7rem; font-size: 1.15rem; }
  .hm-pick { position: relative; }
  .hm-radio { position: absolute; opacity: 0; pointer-events: none; width: 1px; height: 1px; margin: 0; padding: 0; left: 0; top: 0; }
  .hm-chips { display: flex; flex-wrap: wrap; gap: .4rem; }
  .hm-chip { display: inline-flex; gap: .35rem; align-items: center; padding: .4rem .75rem; border: 1px solid var(--border); border-radius: 999px; cursor: pointer; font-size: .9rem; background: var(--panel-2); margin: 0; }
  .hm-chip:hover { border-color: var(--accent); }
  .hm-panels { margin-top: .9rem; border-top: 1px solid var(--border); padding-top: .8rem; min-height: 9.5rem; }
  .hm-panel { display: none; }
  .hm-panel-h { font-weight: 700; margin: 0 0 .4rem; }
  .hm-row { margin: .15rem 0; }
  .hm-panel-cta { justify-content: flex-start; align-items: center; gap: .8rem; margin: .8rem 0 0; }
  <% P.forEach(function (p) { %>
  #hp-<%= p.slug %>:checked ~ .hm-panels .hm-panel-<%= p.slug %> { display: block; }
  #hp-<%= p.slug %>:checked ~ .hm-chips label[for="hp-<%= p.slug %>"] { border-color: var(--accent); color: var(--accent); font-weight: 700; }
  #hp-<%= p.slug %>:focus-visible ~ .hm-chips label[for="hp-<%= p.slug %>"] { outline: 2px solid var(--accent); outline-offset: 2px; }
  <% }) %>
  .hm-pillars { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .8rem; margin: .5rem 0 2rem; }
  .hm-pillars a { display: flex; flex-direction: column; gap: .2rem; padding: .9rem 1rem; border: 1px solid var(--border); border-radius: 14px; background: var(--panel); color: inherit; text-decoration: none; }
  .hm-pillars a:hover { border-color: var(--accent); }
  .hm-kicker { font-size: .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--accent); margin: 0 0 .3rem; }
  .hm-feature { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 2.2rem; align-items: center; margin: 3rem 0; scroll-margin-top: 5rem; }
  .hm-feature.flip .hm-copy { order: 2; }
  .hm-feature h2 { margin: 0 0 .5rem; }
  .hm-shot { margin: 0; border-radius: 16px; overflow: hidden; border: 1px solid var(--border); box-shadow: 0 18px 50px rgba(0,0,0,.18); background: var(--panel); }
  .hm-shot img { display: block; width: 100%; height: auto; }
  .hm-more { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 1rem; margin: 2.5rem 0; }
  .hm-more h3 { margin: 0 0 .4rem; }
  .hm-faq { max-width: 820px; margin: 2.5rem auto; }
  .hm-faq details { margin-bottom: .6rem; }
  .hm-faq summary { cursor: pointer; }
  .hm-faq details p { margin: .6rem 0 0; }
  @media (max-width: 900px) {
    .hm-hero, .hm-feature { grid-template-columns: 1fr; gap: 1.2rem; }
    .hm-feature.flip .hm-copy { order: 0; }
    .hm-pillars { grid-template-columns: 1fr; }
    .hm-hero { padding-top: 1.5rem; }
  }
</style>
<script src="/js/home.js?v=5"></script>
<%- include('partials/foot') %>
